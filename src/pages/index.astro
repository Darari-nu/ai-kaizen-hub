---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Footer from '@/components/Footer.astro';
import HomeMotion from '@/components/HomeMotion.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SubstackEmbed from '@/components/SubstackEmbed.astro';
import { SITE } from '@/config';

const articles = (await getCollection('articles')).sort(
  (a, b) => a.data.number - b.data.number
);

// トップに全記事は並べない（darari指摘 2026-08-13「記事が延々と続く」）。
// 公開済みは全部・準備中(draft)は各軸3本まで。のこりは /articles/ の一覧へ流す
const draftQuota: Record<string, number> = {};
const topArticles = articles.filter((a) => {
  if (!a.data.draft) return true;
  draftQuota[a.data.series] = (draftQuota[a.data.series] ?? 0) + 1;
  return draftQuota[a.data.series] <= 3;
});
const restCount = articles.length - topArticles.length;

// 挿絵がまだ無い記事（書きたて）は画像枠ごと出さない。壊れ画像を出さないための存在チェック
const hasImage = (p: string | undefined) =>
  !!p && fs.existsSync(new URL(`../../public${p}`, import.meta.url));

// AIカイゼン軸だけは「できることメニュー」で逆引きできるようにする（2026-08-08 darari発案）。
// hookはメニュー用の呼び込み文。記事タイトルが正で、メニューにも小さく併記する（釣り防止）
const kaizenMenu = articles.filter((a) => a.data.series === 'AIカイゼン' && a.data.hook);

// ヒーロー画像はMidjourneyで本人制作（public/images/README.md参照）。
// public/images/hero.jpg|png|webp を置けば自動で差し替わる。
const heroImage = ['jpg', 'png', 'webp']
  .map((ext) => `images/hero.${ext}`)
  .find((p) => fs.existsSync(new URL(`../../public/${p}`, import.meta.url)));

// 今後の予告（3軸: 記録・カイゼン・ガバナンス。公開されたらMarkdownに置き換わる。ネタ元: drafts/ネタ帳.md）
const comingSoon = [
  '「国もやれって言ってますよ」——AI基本計画を稟議の武器にする（ガバナンス）',
  'チャットボットにお金払ってません？（AIカイゼン）',
];

// 予告の文末（軸名）から絞り込み用のseriesを判定。無印は「すべて」のときだけ表示
const axisOf = (t: string) => {
  const m = t.match(/（(記録|AIカイゼン|カイゼン|ガバナンス)）$/);
  return m ? (m[1] === 'カイゼン' ? 'AIカイゼン' : m[1]) : '';
};

const pains = [
  '「で、費用対効果は？」と聞かれて、導入する気が消える',
  '「あなたじゃなくて、もっと適した人が」で、くじける',
  'AIの申請を説明するPPTだけで、修正2週間の地獄',
  '個人ならクレカで翌日からAI。会社だと、半年後。',
];

const career = [
  ['製造現場', '10年。現場のしんどさは、体で知ってます'],
  ['プロダクトリーダー', '10年。企画・設計・技術、ひととおりやりました'],
  ['AIガバナンス構築', '全社のAIの決まりごとを作る側。マネジメントサイクルの仕組みまで'],
  ['現職', '製造部門のAI活用推進責任者。Claude Teamを会社に通しました'],
];

const faqs = [
  {
    q: '非エンジニアですが、読めますか？',
    a: 'そのための無料コンテンツです。「サーバーって何？」から説明します。専門語が出たら、その場でかみくだいて言い換えるのがこのサイトの約束です。',
  },
  {
    q: '会社の情報を書いて、大丈夫なんですか？',
    a: '会社の機密は書きません。書くのは「どの会社にもある壁」と、その突破手順です。だからあなたの会社でも使えます。',
  },
  {
    q: '何から読めばいいですか？',
    a: 'まずはNo.001から。読んで「使えそう」と思ったら、Substackに登録してもらえたら続きが届きます。',
  },
];
---

<Base>
  <main>
    <HomeMotion />
    <!-- 1. ヒーロー（ダーク没入。イラストの夜に飛び込み、下の紙白へ抜ける） -->
    <section class="relative overflow-hidden bg-dusk text-paper">
      {
        heroImage && (
          <div class="hero-media absolute inset-0 lg:left-[42%]" data-hero-fade>
            <img
              src={`/${heroImage}`}
              alt=""
              class="h-full w-full object-cover object-[48%_center] lg:object-[70%_center]"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-dusk via-dusk/55 to-dusk/10" />
            <div class="absolute inset-0 bg-dusk/45 lg:bg-transparent" />
          </div>
        )
      }
      <div class="relative mx-auto max-w-site px-5">
        <div class="flex items-baseline justify-between py-5">
          <span class="font-display text-lg font-bold tracking-wide">{SITE.name}</span>
          <a
            href={SITE.substackUrl}
            class="text-sm text-paper/70 underline decoration-paper/30 underline-offset-4 hover:text-paper"
            >Substackで読む</a
          >
        </div>
        <div class="max-w-xl pb-28 pt-16 sm:pt-24 lg:pb-40 lg:pt-32">
          <p class="text-xs tracking-[0.3em] text-paper/60" data-hero-rise style="--rise-delay:120ms">
            会社員のための、AI導入の実況
          </p>
          <h1
            class="mt-5 font-display text-4xl font-black leading-tight tracking-tight sm:text-5xl"
            data-hero-rise
            style="--rise-delay:260ms"
          >
            申請から使い倒すまで、<br /><span class="text-shu">ぜんぶ</span>見せます。
          </h1>
          <p class="mt-7 max-w-prose leading-relaxed text-paper/85" data-hero-rise style="--rise-delay:400ms">
            「うちの会社じゃ無理」って思ってませんか？——その稟議、通せます。
            製造業の中の人・だらリーヌが、会社にAIを申請して、導入して、使い倒すまでを、
            先にぼくが失敗した記録ごと公開します。読むのは無料。むずかしい言葉は、その場でかみくだきます。
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-5" data-hero-rise style="--rise-delay:540ms">
            <a
              href="#articles"
              class="bg-paper px-7 py-3.5 font-bold text-ink no-underline shadow-[5px_5px_0_#C73E2E] transition-all duration-100 hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_#C73E2E] active:translate-x-1 active:translate-y-1 active:shadow-none"
              >無料で読みはじめる</a
            >
            <a
              href="#register"
              class="text-sm text-paper/70 underline decoration-paper/30 underline-offset-4 hover:text-paper"
              >さきにSubstack登録する</a
            >
          </div>
        </div>
        <p class="pb-6 text-right text-[11px] tracking-[0.3em] text-paper/50" data-hero-fade style="--rise-delay:800ms">
          申請は、通せる。
        </p>
      </div>
    </section>

    <!-- 2. ペイン -->
    <section class="bg-kinari">
      <div class="mx-auto max-w-site px-5 py-20">
        <SectionLabel text="よくある壁" data-reveal />
        <h2 class="mt-5 font-display text-3xl font-extrabold leading-snug sm:text-4xl" data-reveal>
          こんな壁に、ぶつかってません？
        </h2>
        <ul class="mt-10 max-w-2xl">
          {
            pains.map((p, i) => (
              <li
                class:list={[
                  'flex items-baseline gap-6 border-rule py-5 leading-relaxed',
                  i > 0 && 'border-t rule-draw',
                ]}
                data-reveal
              >
                <span class="font-display text-4xl font-extrabold text-ink/15">0{i + 1}</span>
                <span class="text-lg">{p}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 max-w-prose leading-relaxed" data-reveal>
          ぜんぶ、ぼくが実際に食らった壁です。だからこのサイトには、突破した手順だけを置いていきます。
        </p>
      </div>
    </section>

    <!-- 3. 無料コンテンツ -->
    <section id="articles">
      <div class="mx-auto max-w-site px-5 py-20">
        <SectionLabel text="無料コンテンツ" data-reveal />
        <h2 class="mt-5 font-display text-3xl font-extrabold leading-snug sm:text-4xl" data-reveal>
          ぜんぶ無料で、置いておきます。
        </h2>
        <div class="mt-10 grid gap-7 sm:grid-cols-3">
          <a href="#article-list" data-series-link="記録" class="group block no-underline" data-reveal data-reveal-delay="0">
            <div class="overflow-hidden">
              <img
                src="/images/axis/kiroku.png"
                alt=""
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
              />
            </div>
            <p class="mt-4 font-display text-lg font-bold">記録<span class="ml-2 text-shu">──</span></p>
            <p class="mt-1 text-sm leading-relaxed text-nezu">会社にAIを申請→導入→使い倒す実況</p>
          </a>
          <a href="#article-list" data-series-link="AIカイゼン" class="group block no-underline" data-reveal data-reveal-delay="130">
            <div class="overflow-hidden">
              <img
                src="/images/axis/kaizen.png"
                alt=""
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
              />
            </div>
            <p class="mt-4 font-display text-lg font-bold">AIカイゼン<span class="ml-2 text-shu">──</span></p>
            <p class="mt-1 text-sm leading-relaxed text-nezu">明日の業務がラクになる道具</p>
          </a>
          <a href="#article-list" data-series-link="ガバナンス" class="group block no-underline" data-reveal data-reveal-delay="260">
            <div class="overflow-hidden">
              <img
                src="/images/axis/governance.png"
                alt=""
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
              />
            </div>
            <p class="mt-4 font-display text-lg font-bold">ガバナンス<span class="ml-2 text-shu">──</span></p>
            <p class="mt-1 text-sm leading-relaxed text-nezu">元・全社AIガバナンス担当が訳す、AIの決まりごと</p>
          </a>
        </div>

        {
          kaizenMenu.length > 0 && (
            <div class="mt-14 border-2 border-ink" id="kaizen-menu" data-reveal>
              <p class="border-b-2 border-ink bg-ink px-5 py-3 font-display text-sm font-bold tracking-[0.15em] text-paper">
                AIカイゼン<span class="mx-2 text-shu">──</span>そのお金と手間、浮かせられるかもしれません
              </p>
              <ul class="m-0 list-none p-0">
                {kaizenMenu.map((a) => (
                  <li class="border-t border-rule first:border-t-0">
                    {a.data.draft ? (
                      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 px-5 py-4 opacity-70">
                        <span class="font-display font-bold">{a.data.hook}</span>
                        <span class="border border-nezu px-1.5 py-0.5 text-[11px] tracking-widest text-nezu">準備中</span>
                        <span class="w-full text-xs text-nezu">{a.data.title}</span>
                      </div>
                    ) : (
                      <a
                        href={`/articles/${a.slug}/`}
                        class="group flex flex-wrap items-baseline gap-x-3 gap-y-0.5 px-5 py-4 no-underline hover:bg-kinari"
                      >
                        <span class="font-display font-bold underline decoration-rule underline-offset-4 group-hover:text-shu group-hover:decoration-shu">
                          {a.data.hook}
                        </span>
                        <span class="w-full text-xs text-nezu">{a.data.title}</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="mt-12 flex flex-wrap items-center gap-2" id="series-tabs" data-reveal>
          <span class="mr-1 font-display text-xs tracking-[0.2em] text-nezu">しぼりこみ</span>
          <button type="button" data-filter="" class="border border-ink bg-ink px-3 py-1.5 font-display text-sm font-bold text-paper">すべて</button>
          <button type="button" data-filter="記録" class="border border-rule px-3 py-1.5 font-display text-sm font-bold text-nezu hover:border-ink hover:text-ink">記録</button>
          <button type="button" data-filter="AIカイゼン" class="border border-rule px-3 py-1.5 font-display text-sm font-bold text-nezu hover:border-ink hover:text-ink">AIカイゼン</button>
          <button type="button" data-filter="ガバナンス" class="border border-rule px-3 py-1.5 font-display text-sm font-bold text-nezu hover:border-ink hover:text-ink">ガバナンス</button>
        </div>
        <div class="mt-4" id="article-list">
          {
            topArticles.map((a) => (
              <article
                class="group flex gap-7 border-t border-rule py-7 first:border-t-2 first:border-ink"
                data-series={a.data.series}
                data-reveal
              >
                {hasImage(a.data.ogImage) && (
                  <div class="hidden w-56 shrink-0 overflow-hidden sm:block">
                    <img
                      src={a.data.ogImage}
                      alt=""
                      class:list={[
                        'aspect-video w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]',
                        a.data.draft && 'opacity-60',
                      ]}
                    />
                  </div>
                )}
                <div>
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    <span class="font-display text-sm text-nezu">
                      No.{String(a.data.number).padStart(3, '0')}
                    </span>
                    {a.data.draft ? (
                      <span class="font-display text-xl font-bold text-nezu">{a.data.title}</span>
                    ) : (
                      <a
                        href={`/articles/${a.slug}/`}
                        class="font-display text-xl font-bold underline decoration-rule underline-offset-4 hover:text-shu hover:decoration-shu"
                      >
                        {a.data.title}
                      </a>
                    )}
                    {a.data.draft && (
                      <span class="border border-nezu px-1.5 py-0.5 text-[11px] tracking-widest text-nezu">
                        準備中
                      </span>
                    )}
                  </div>
                  <p class="mt-2 max-w-prose text-sm leading-relaxed text-nezu">
                    {a.data.description}
                  </p>
                </div>
              </article>
            ))
          }
          {
            comingSoon.map((t, i) => (
              <article class="border-t border-rule py-5" data-series={axisOf(t)} data-reveal>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <span class="font-display text-sm text-nezu">
                    No.{String(articles.length + i + 1).padStart(3, '0')}
                  </span>
                  <span class="font-display text-xl font-bold text-nezu">{t}</span>
                  <span class="border border-nezu px-1.5 py-0.5 text-[11px] tracking-widest text-nezu">
                    執筆中
                  </span>
                </div>
              </article>
            ))
          }
          <div class="border-t border-rule"></div>
        </div>
        {
          restCount > 0 && (
            <div class="mt-10" data-reveal>
              <a
                href="/articles/"
                class="inline-block border border-ink px-7 py-3.5 font-display font-bold no-underline hover:bg-ink hover:text-paper"
              >
                準備中もふくめて、記事一覧へ<span class="ml-3 text-shu">──</span>のこり{restCount}本
              </a>
            </div>
          )
        }
      </div>
    </section>

    <script is:inline>
      (() => {
        const tabs = Array.from(document.querySelectorAll('#series-tabs [data-filter]'));
        const rows = Array.from(document.querySelectorAll('#article-list [data-series]'));
        const cards = Array.from(document.querySelectorAll('[data-series-link]'));
        const menuBox = document.getElementById('kaizen-menu');
        const on = ['border-ink', 'bg-ink', 'text-paper'];
        const off = ['border-rule', 'text-nezu'];
        const apply = (series) => {
          rows.forEach((el) => {
            el.style.display = !series || el.dataset.series === series ? '' : 'none';
          });
          tabs.forEach((b) => {
            const active = (b.dataset.filter || '') === (series || '');
            on.forEach((c) => b.classList.toggle(c, active));
            off.forEach((c) => b.classList.toggle(c, !active));
          });
          if (menuBox) menuBox.style.display = !series || series === 'AIカイゼン' ? '' : 'none';
        };
        tabs.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter || null)));
        cards.forEach((c) => c.addEventListener('click', () => apply(c.dataset.seriesLink)));
      })();
    </script>

    <!-- 4. 書いてる人 -->
    <section>
      <div class="mx-auto max-w-site px-5 py-20">
        <SectionLabel text="書いてる人" data-reveal />
        <h2 class="mt-5 font-display text-3xl font-extrabold leading-snug sm:text-4xl" data-reveal>
          書いてるのは、だらリーヌ。
        </h2>
        <dl class="mt-8 max-w-prose">
          {
            career.map(([t, d], i) => (
              <div
                class:list={[
                  'flex flex-col gap-1 border-rule py-4 sm:flex-row sm:gap-6',
                  i > 0 && 'border-t rule-draw',
                ]}
                data-reveal
              >
                <dt class="shrink-0 font-display font-bold sm:w-48">{t}</dt>
                <dd class="leading-relaxed text-nezu">{d}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-6 max-w-prose leading-relaxed" data-reveal>
          肩書きで信じてもらうつもりはないんです。実際に通した記録を読んで、「これならうちでもいける」と思ってもらうのがこのサイトの仕事です。
          くわしくは<a
            href="/about/"
            class="underline decoration-rule underline-offset-4 hover:text-shu">プロフィール</a
          >へ。
        </p>
      </div>
    </section>

    <!-- 5. なぜ無料か -->
    <section class="bg-kinari">
      <div class="mx-auto max-w-site px-5 py-20">
        <SectionLabel text="たいせつなこと" data-reveal />
        <h2 class="mt-5 font-display text-3xl font-extrabold leading-snug sm:text-4xl" data-reveal>
          なぜ、ぜんぶ無料なのか。
        </h2>
        <p class="mt-6 max-w-prose leading-relaxed" data-reveal>
          「怪しくない？」——ですよね。理由はシンプルで、ぼくには本業があるからです。
          ここで売り込む必要がないんです。読んで「使えた」と思ったら、Substackで読者になってくれたら、それで十分。
          その代わり、中身は本気で書きます。
        </p>
      </div>
    </section>

    <!-- 6. 登録CTA(ダークバンド。ヒーローと呼応) -->
    <section id="register" class="bg-dusk text-paper">
      <div class="mx-auto max-w-site px-5 py-20">
        <span class="inline-flex items-center gap-2 text-[11px] tracking-[0.3em] text-paper/60" data-reveal
          ><span class="inline-block h-px w-6 bg-shu"></span>ニュースレター</span
        >
        <h2 class="mt-5 font-display text-3xl font-extrabold leading-snug sm:text-4xl" data-reveal>
          続きは、受信箱に届きます。
        </h2>
        <p class="mt-4 max-w-prose leading-relaxed text-paper/85" data-reveal>
          新しい記事と、会社にAIを通す実況の続きを、Substackで配信しています。登録は無料。メールアドレスだけです。
        </p>
        <div class="mt-7" data-reveal>
          <SubstackEmbed />
        </div>
      </div>
    </section>

    <!-- 7. FAQ -->
    <section>
      <div class="mx-auto max-w-site px-5 py-20">
        <SectionLabel text="はじめての方へ" data-reveal />
        <h2 class="mt-5 font-display text-3xl font-extrabold leading-snug sm:text-4xl" data-reveal>
          よくある質問
        </h2>
        <div class="mt-8 max-w-prose">
          {
            faqs.map((f, i) => (
              <details
                class:list={['group border-rule py-4', i > 0 && 'border-t rule-draw']}
                data-reveal
              >
                <summary class="flex cursor-pointer list-none items-baseline gap-4 font-bold">
                  <span class="font-display text-sm text-nezu">Q</span>
                  {f.q}
                </summary>
                <p class="mt-3 pl-7 leading-relaxed text-nezu">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
