---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import SubstackEmbed from '@/components/SubstackEmbed.astro';

export async function getStaticPaths() {
  // draft記事は本番ビルドから除外（開発中はプレビュー可）
  const articles = await getCollection('articles', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const date = article.data.pubDate.toISOString().slice(0, 10);
---

<Base
  title={article.data.title}
  description={article.data.description}
  ogImage={article.data.ogImage}
>
  <Header />
  <main class="mx-auto max-w-site px-5 py-14">
    <article>
      <header class="max-w-prose">
        {article.data.series && <SectionLabel text={article.data.series} />}
        <h1 class="mt-4 font-display text-3xl font-black leading-tight sm:text-4xl">
          {article.data.title}
        </h1>
        <p class="mt-3 text-sm text-nezu">
          No.{String(article.data.number).padStart(3, '0')}｜{date}｜だらリーヌ
        </p>
      </header>
      {
        article.data.ogImage && (
          <figure class="mt-8 max-w-2xl">
            <img src={article.data.ogImage} alt="" class="aspect-video w-full object-cover" />
          </figure>
        )
      }
      <div class="article-body mt-10 max-w-prose">
        <Content />
      </div>
    </article>
    <div class="mt-14 max-w-prose border-t-2 border-ink pt-8">
      <p class="font-display text-xl font-bold">続きは、受信箱に届きます。</p>
      <p class="mt-2 leading-relaxed text-nezu">
        新しい記事はSubstackで配信しています。登録は無料、メールアドレスだけです。
      </p>
      <div class="mt-4">
        <SubstackEmbed />
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style is:global>
  .article-body {
    line-height: 1.9;
  }
  .article-body h2 {
    font-family: 'Zen Old Mincho', serif;
    font-weight: 700;
    font-size: 1.4rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e3e0d8;
  }
  .article-body h3 {
    font-weight: 700;
    font-size: 1.1rem;
    margin-top: 2rem;
  }
  .article-body p {
    margin-top: 1rem;
  }
  .article-body ul,
  .article-body ol {
    margin-top: 1rem;
    padding-left: 1.5rem;
  }
  .article-body ul {
    list-style: disc;
  }
  .article-body ol {
    list-style: decimal;
  }
  .article-body li + li {
    margin-top: 0.4rem;
  }
  .article-body a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: #e3e0d8;
  }
  .article-body a:hover {
    color: #c73e2e;
    text-decoration-color: #c73e2e;
  }
  .article-body code {
    background: #f2f0ea;
    padding: 0.1em 0.4em;
    font-size: 0.9em;
  }
  .article-body pre {
    margin-top: 1rem;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid #e3e0d8;
  }
  .article-body pre code {
    background: none;
    padding: 0;
  }
  /* 引用ブロックは「ことばメモ」カードとして使う（用語補足用） */
  .article-body blockquote {
    margin-top: 1.25rem;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid #c73e2e;
    background: #f6f2ea;
    color: #1c1b18;
    font-size: 0.92em;
  }
  .article-body blockquote p {
    margin-top: 0;
  }
</style>
