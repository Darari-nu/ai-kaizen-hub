---
// 内部監査・是正処置(CAPA)台帳 — ダラリ重工業の品質システム(という設定のパロディページ)。
// ISO 9001内部監査の指摘台帳＋是正処置報告書(様式Q-5・なぜなぜ5回)。
// 「ISO9001×AIカイゼン」連載(ネタ帳118)の実機。「なぜなぜ分析をAIとやる」記事の実演場所。
// なぜが2回で止まると差戻しされる(真因未到達)。保存はlocalStorage(件数のみ)。
import Base from '@/layouts/Base.astro';

// 指摘台帳: [指摘番号, 部門, 区分, 指摘内容, 状態]
const findings: [string, string, string, string, string][] = [
  ['NC-2026-01', '製造一課', '軽微', '作業標準書の版数が現場掲示と文書管理システムで不一致（現場: 第4版／システム: 第6版）', '是正処置 回答期限超過'],
  ['NC-2026-02', '製造二課', '観察', '検査記録の記入漏れ防止策が「気をつける」となっており、仕組みになっていない', '是正処置 提出済み（有効性確認待ち）'],
  ['NC-2026-03', '調達部', '軽微', 'サプライヤー評価シートの「情報管理」の項が最新版様式で運用されていない', '是正処置 提出済み'],
  ['NC-2026-04', '開発本部', '重大', 'DR2を持ち回り承認で代えた事例が1件確認された（開基-001違反）', '是正処置 提出済み（水平展開 実施中）'],
  ['NC-2026-05', 'AI活用推進室', '観察', 'AIサービス利用台帳は整備されているが、利用実態の定期確認の記録がない', '是正処置 作成中 ←今ここ'],
];
---

<Base
  title="内部監査・是正処置台帳（架空企業の社内システム）"
  description="架空企業ダラリ重工業の内部監査指摘台帳と是正処置報告書・様式Q-5（という設定のページ）。なぜなぜ分析が2回で止まると差戻しされます。"
>
  <div
    class="min-h-screen bg-[#d4d0c8] text-[13px] text-[#222]"
    style="font-family: 'Hiragino Kaku Gothic ProN', 'MS PGothic', 'Yu Gothic', sans-serif;"
  >
    <div class="bg-shu px-4 py-2 text-center text-xs font-bold text-white">
      ⚠️ これは「<a href="/" class="underline decoration-white/60 underline-offset-2">AIカイゼン</a>」の記事に登場する架空企業の社内システム（という設定）です。実際に入力して遊べます（保存はお使いのブラウザ内のみ）。
    </div>

    <div class="border-b-4 border-[#1b3a6b] bg-gradient-to-b from-[#3a5f9e] to-[#1b3a6b] px-4 py-3 text-white">
      <div class="mx-auto flex max-w-4xl items-baseline justify-between">
        <p class="text-lg font-bold">内部監査・是正処置（CAPA）台帳</p>
        <p class="text-[11px] text-white/80">所管: 品質保証部 ｜ ISO 9001 内部監査（2026年度 上期）</p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl space-y-4 px-4 py-6">
      <p class="mb-1 text-[11px]">
        <a href="/company/intranet/" class="text-[#00c] underline">DARARIポータル</a> &gt; 品質 &gt; 内部監査・是正処置台帳
      </p>

      <div class="border border-[#999] bg-[#fffbe6] px-3 py-2 text-[11px] leading-relaxed">
        【重要】是正処置報告書（様式Q-5）の提出期限は<b class="text-[#c00]">指摘から30日以内</b>です。期限超過は月例品質会議で読み上げられます。<br />
        【注意】原因分析は「なぜなぜ」を5回まで掘ってください。<b>「担当者の不注意」で止めた報告書は差戻し</b>になります（人を責めるな、仕組みを直せ）。<br />
        【参考】品質本部長の口ぐせ「ゼロは目標ではなく前提」。有効性確認は3ヶ月後に品質保証部が実施します。
      </div>

      <!-- 指摘台帳 -->
      <div class="border border-[#999] bg-white">
        <p class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">■ 2026年度上期 内部監査 指摘一覧</p>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[680px] border-collapse text-[12px]">
            <thead>
              <tr class="bg-[#f5f5f0] text-left">
                <th class="w-28 border border-[#ddd] px-2 py-1.5">指摘番号</th>
                <th class="w-28 border border-[#ddd] px-2 py-1.5">部門</th>
                <th class="w-16 border border-[#ddd] px-2 py-1.5">区分</th>
                <th class="border border-[#ddd] px-2 py-1.5">指摘内容</th>
                <th class="w-44 border border-[#ddd] px-2 py-1.5">状態</th>
              </tr>
            </thead>
            <tbody>
              {
                findings.map(([no, dept, kubun, naiyo, state]) => (
                  <tr>
                    <td class="border border-[#ddd] px-2 py-1.5 whitespace-nowrap">{no}</td>
                    <td class="border border-[#ddd] px-2 py-1.5">{dept}</td>
                    <td class:list={['border border-[#ddd] px-2 py-1.5 text-center font-bold', kubun === '重大' ? 'text-[#c00]' : kubun === '軽微' ? 'text-[#a06000]' : 'text-[#888]']}>{kubun}</td>
                    <td class="border border-[#ddd] px-2 py-1.5">{naiyo}</td>
                    <td class:list={['border border-[#ddd] px-2 py-1.5 text-[11px]', state.includes('超過') && 'font-bold text-[#c00]']}>{state}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- 是正処置報告書 -->
      <div class="border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">是正処置報告書（様式Q-5）</p>
        <form id="capa-form" class="p-4">
          <table class="w-full border-collapse">
            <tbody>
              <tr class="border-b border-[#ddd]">
                <th class="w-44 bg-[#eef1f5] px-3 py-2 text-left font-normal">対象の指摘番号<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2">
                  <select id="capa-no" class="border border-[#999] bg-white px-2 py-1">
                    {findings.map(([no]) => <option>{no}</option>)}
                  </select>
                </td>
              </tr>
              {
                [1, 2, 3, 4, 5].map((n) => (
                  <tr class="border-b border-[#ddd]">
                    <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">
                      なぜ{n}{n <= 3 && <span class="ml-1 text-[#c00]">*</span>}
                    </th>
                    <td class="px-3 py-2">
                      <input id={`capa-naze-${n}`} type="text" class="w-full border border-[#999] bg-white px-2 py-1" placeholder={n === 1 ? '例: 現場の作業標準書が旧版だったのはなぜか' : ''} />
                    </td>
                  </tr>
                ))
              }
              <tr class="border-b border-[#ddd]">
                <th class="bg-[#eef1f5] px-3 py-2 text-left align-top font-normal">是正処置（仕組みの変更）<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><textarea id="capa-shochi" rows="3" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="「教育する」「周知徹底する」だけの処置は有効性確認で落ちます。仕組み(様式・手順・システム)の変更を書く"></textarea></td>
              </tr>
              <tr>
                <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">水平展開</th>
                <td class="px-3 py-2 text-[11px]"><label><input type="checkbox" id="capa-suihei" class="mr-1" />他部門・他ラインへの水平展開を検討した</label></td>
              </tr>
            </tbody>
          </table>
          <div class="mt-4 flex items-center gap-3">
            <button type="submit" class="border border-[#1b3a6b] bg-gradient-to-b from-[#4a6fae] to-[#1b3a6b] px-6 py-1.5 font-bold text-white">提出</button>
            <span class="text-[11px] text-[#666]">提出後、品質保証部の受理審査があります（差戻し率 約4割）。</span>
          </div>
          <div id="capa-result" class="mt-3 hidden border px-3 py-2 text-[12px] font-bold"></div>
        </form>
      </div>

      <p class="mt-4 text-[11px] text-[#666]">品質保証部 内線 3300 ｜ 監査員の指名は毎年4月（被監査部門と利害関係のない者から選任）</p>
    </div>
  </div>

  <script>
    // 掟: 本体が無いページでは何もしない（存在ガード。非null断定は禁止）
    const capaForm = document.getElementById('capa-form');
    if (capaForm) initCapa(capaForm as HTMLFormElement);

    function initCapa(capaForm: HTMLFormElement) {
      capaForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = (id: string) =>
          (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value?.trim() || '';
        const result = document.getElementById('capa-result');
        if (!result) return;
        result.classList.remove('hidden');
        const ng = (msg: string) => {
          result.textContent = msg;
          result.className = 'mt-3 border border-[#c00] bg-[#fdeaea] px-3 py-2 text-[12px] font-bold text-[#c00]';
        };

        const nazes = [1, 2, 3, 4, 5].map((n) => val(`capa-naze-${n}`));
        const depth = nazes.filter(Boolean).length;
        if (depth === 0) return ng('差戻し: 原因分析がありません。なぜ1から記入してください。');
        if (nazes[0] === '' || (depth >= 1 && nazes.slice(0, depth).some((s) => s === ''))) {
          return ng('差戻し: なぜが途中で飛んでいます。なぜ1から順に埋めてください。');
        }
        if (depth < 3) return ng(`差戻し: なぜが${depth}回で止まっています。真因に到達していません。最低3回、できれば5回まで掘ってください（品質保証部）。`);
        if (nazes.slice(0, depth).some((s) => /不注意|うっかり|意識が低|気の緩み/.test(s))) {
          return ng('差戻し: 原因が「人」で止まっています（不注意・意識・気の緩み）。人を責めるな、仕組みを直せ。その人がなぜそうせざるを得なかったかを掘ってください。');
        }
        const shochi = val('capa-shochi');
        if (!shochi) return ng('差戻し: 是正処置が未記入です。');
        if (/^(教育する|周知徹底する|注意喚起する)。?$/.test(shochi)) {
          return ng('差戻し: 「教育する」「周知徹底する」だけの処置は3ヶ月後の有効性確認で落ちます。仕組み（様式・手順・システム）の変更を書いてください。');
        }
        const no = 'Q5-2026-' + String(Math.floor(Math.random() * 90000) + 10000);
        result.textContent = `受理番号 ${no} で受け付けました（対象: ${val('capa-no')}）。有効性確認は3ヶ月後です。水平展開の結果は月例品質会議で報告してください。`;
        result.className = 'mt-3 border border-[#1b3a6b] bg-[#eef7ee] px-3 py-2 text-[12px] font-bold';
      });
    }
  </script>
</Base>
