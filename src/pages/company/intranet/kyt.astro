---
// 安全衛生ポータル（KYT・ワンポイントレッスン） — ダラリ重工業の社内システム(という設定のパロディページ)。
// darari発案(2026-08-17)「ワンポイントレッスン作りすぎてワンポイントじゃない→AIでナレッジ化」の実機。
// KYT(危険予知訓練)4ラウンド法の記録フォーム＋OPL台帳1,247件(の体)。
// 記事042「AIリスクアセスメントはKYTと同じ」の実演場所にもなる。保存はlocalStorage。
import Base from '@/layouts/Base.astro';

// OPL台帳(抜粋の体): [番号, タイトル, 部門, 年, ページ数]
const opl: [string, string, string, string, string][] = [
  ['No.0001', 'ワンポイントレッスンの書き方', '安全衛生室', '2003年', '全12ページ'],
  ['No.0087', '脚立の最上段に乗らない', '製造一課', '2008年', '1ページ'],
  ['No.0214', 'グラインダーの火花の方向を確認する', '製造二課', '2011年', '1ページ'],
  ['No.0455', '台車は引かずに押す（曲がり角は特に）', '物流課', '2015年', '1ページ'],
  ['No.0623', 'ワンポイントレッスンが見つからないときの探し方', '安全衛生室', '2017年', '全9ページ'],
  ['No.0891', '保護メガネの曇り止めは拭く前に洗う', '品質保証部', '2020年', '1ページ'],
  ['No.0930', '冬季の朝一番、金属部品は素手で触らない', '製造一課', '2021年', '1ページ'],
  ['No.1024', '感電は音がしない（低圧でも死亡災害になる）', '生産技術課', '2022年', '2ページ'],
  ['No.1130', 'AIに社内情報を入れる前に確認する3点', 'AI活用推進室', '2026年', '1ページ'],
  ['No.1198', '熱中症は「喉が渇く前」に飲む', '安全衛生室', '2026年', '1ページ'],
  ['No.1246', '休日出勤申請書（様式K-4）の書き方', '人事部 勤労課', '2026年', '3ページ'],
  ['No.1247', 'ワンポイントレッスンの減らし方', '安全衛生室', '2026年', '検討中'],
];
---

<Base
  title="KYT・ワンポイントレッスン（架空企業の社内システム）"
  description="架空企業ダラリ重工業の安全衛生ポータル（という設定のページ）。KYT（危険予知訓練）4ラウンド法の記録と、1,247件に増殖したワンポイントレッスン台帳。"
>
  <div
    class="min-h-screen bg-[#d4d0c8] text-[13px] text-[#222]"
    style="font-family: 'Hiragino Kaku Gothic ProN', 'MS PGothic', 'Yu Gothic', sans-serif;"
  >
    <div class="bg-shu px-4 py-2 text-center text-xs font-bold text-white">
      ⚠️ これは「<a href="/" class="underline decoration-white/60 underline-offset-2">AIカイゼン</a>」の記事に登場する架空企業の社内システム（という設定）です。実際に入力して遊べます（保存はお使いのブラウザ内のみ）。
    </div>

    <div class="border-b-4 border-[#1b3a6b] bg-gradient-to-b from-[#3a5f9e] to-[#1b3a6b] px-4 py-3 text-white">
      <div class="mx-auto flex max-w-4xl items-baseline justify-between">
        <p class="text-lg font-bold">安全衛生ポータル（KYT・ワンポイントレッスン）</p>
        <p class="text-[11px] text-white/80">所管: 安全衛生室 ｜ ご安全に</p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-4 py-6">
      <p class="mb-1 text-[11px]">
        <a href="/company/intranet/" class="text-[#00c] underline">DARARIポータル</a>
        &gt; 安全衛生 &gt; KYT・ワンポイントレッスン
      </p>

      <div class="mb-4 border border-[#999] bg-[#fffbe6] px-3 py-2 text-[11px] leading-relaxed">
        【今月の安全標語】「まだいける」 その油断が 命取り（製造二課・入選作）<br />
        【お知らせ】ワンポイントレッスン（OPL）は現在<b>1,247件</b>あります。1件1分でも通読に<b class="text-[#c00]">20時間47分</b>かかります。
        ナレッジ整理の方法を検討中です（AI活用推進室に期待——安全衛生室）。<br />
        【参考】社長訓示「慣れた頃が、いちばん危ない」は<a href="/company/message/" class="text-[#00c] underline">社長メッセージ</a>に掲載しています。
      </div>

      <!-- KYT記録 -->
      <div class="border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">KYT（危険予知訓練）記録 — 4ラウンド法</p>
        <form id="kyt-form" class="p-4">
          <table class="w-full border-collapse">
            <tbody>
              <tr class="border-b border-[#ddd]">
                <th class="w-52 bg-[#eef1f5] px-3 py-2 text-left font-normal">職場<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2">
                  <select id="kyt-shokuba" class="border border-[#999] bg-white px-2 py-1">
                    <option>製造一課</option>
                    <option>製造二課</option>
                    <option>生産技術課</option>
                    <option>物流課</option>
                    <option>品質保証部</option>
                    <option>AI活用推進室</option>
                  </select>
                </td>
              </tr>
              <tr class="border-b border-[#ddd]">
                <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">作業・場面<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><input id="kyt-bamen" type="text" placeholder="例: 段取り替えで金型を台車で運搬する" class="w-full border border-[#999] bg-white px-2 py-1" /></td>
              </tr>
              <tr class="border-b border-[#ddd]">
                <th class="bg-[#eef1f5] px-3 py-2 text-left align-top font-normal">R1 どんな危険がひそんでいるか<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><textarea id="kyt-r1" rows="3" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="「〜なので、〜して、〜になる」の形で複数挙げる"></textarea></td>
              </tr>
              <tr class="border-b border-[#ddd]">
                <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">R2 これが危険のポイントだ<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><input id="kyt-r2" type="text" placeholder="R1から最重要の1つに絞る" class="w-full border border-[#999] bg-white px-2 py-1" /></td>
              </tr>
              <tr class="border-b border-[#ddd]">
                <th class="bg-[#eef1f5] px-3 py-2 text-left align-top font-normal">R3 あなたならどうする<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><textarea id="kyt-r3" rows="3" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="対策を複数挙げる"></textarea></td>
              </tr>
              <tr>
                <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">R4 私達はこうする（行動目標）<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2">
                  <input id="kyt-r4" type="text" placeholder="例: 曲がり角では一旦停止して指差し確認 ヨシ！" class="w-full border border-[#999] bg-white px-2 py-1" />
                  <p class="mt-1 text-[10px] text-[#888]">※ 行動目標は指差し唱和で締めてください（「〜 ヨシ！」）。</p>
                </td>
              </tr>
            </tbody>
          </table>
          <div class="mt-4 flex items-center gap-3">
            <button type="submit" id="kyt-submit" class="border border-[#1b3a6b] bg-gradient-to-b from-[#4a6fae] to-[#1b3a6b] px-6 py-1.5 font-bold text-white">記録する</button>
            <span id="kyt-count" class="text-[11px] text-[#666]"></span>
          </div>
          <p id="kyt-result" class="mt-3 hidden border px-3 py-2 text-[12px] font-bold"></p>
        </form>
      </div>

      <!-- OPL台帳 -->
      <div class="mt-4 border border-[#999] bg-white">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#999] bg-[#eef1f5] px-3 py-1.5">
          <p class="font-bold text-[#1b3a6b]">■ ワンポイントレッスン台帳（全1,247件・抜粋掲示）</p>
          <input id="opl-q" type="text" placeholder="台帳内検索" class="border border-[#999] bg-white px-2 py-0.5 text-[11px]" />
        </div>
        <table class="w-full border-collapse text-[12px]">
          <thead>
            <tr class="bg-[#f5f5f0] text-left">
              <th class="w-20 border border-[#ddd] px-3 py-1.5">番号</th>
              <th class="border border-[#ddd] px-3 py-1.5">タイトル</th>
              <th class="w-32 border border-[#ddd] px-3 py-1.5">作成部門</th>
              <th class="w-20 border border-[#ddd] px-3 py-1.5">作成年</th>
              <th class="w-24 border border-[#ddd] px-3 py-1.5">分量</th>
            </tr>
          </thead>
          <tbody id="opl-rows">
            {
              opl.map(([no, title, dept, year, pages]) => (
                <tr>
                  <td class="border border-[#ddd] px-3 py-1.5 whitespace-nowrap">{no}</td>
                  <td class="border border-[#ddd] px-3 py-1.5">
                    <span class="cursor-default text-[#00c] underline decoration-dotted">{title}</span>
                    {no === 'No.1130' && <span class="ml-2 bg-[#c00] px-1.5 py-0.5 text-[9px] font-bold text-white">NEW</span>}
                  </td>
                  <td class="border border-[#ddd] px-3 py-1.5">{dept}</td>
                  <td class="border border-[#ddd] px-3 py-1.5">{year}</td>
                  <td class:list={['border border-[#ddd] px-3 py-1.5 text-[11px]', pages.includes('全') && 'font-bold text-[#c00]']}>{pages}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="px-3 py-2 text-[11px] leading-relaxed text-[#888]">
          ※ 「ワンポイント」は1ページの意です。複数ページのものが年々増えており、安全衛生室では名称の変更を含め検討しています（2019年より検討中）。<br />
          ※ 原本は各職場の安全ファイル（紙・緑の背表紙）に綴じられています。全文の電子化は整備待ちです。
        </p>
      </div>

      <p class="mt-4 text-[11px] text-[#666]">
        推奨環境: Internet Explorer 11 ｜ 安全衛生室 内線 3900 ｜ 本日も一日、ご安全に
      </p>
    </div>
  </div>

  <script>
    // 掟: 本体が無いページでは何もしない（存在ガード。非null断定は禁止）
    const kytForm = document.getElementById('kyt-form');
    if (kytForm) initKyt(kytForm as HTMLFormElement);

    function initKyt(kytForm: HTMLFormElement) {
      const KEY = 'darari-kyt';
      const load = (): number => {
        const n = Number(localStorage.getItem(KEY));
        return Number.isFinite(n) && n > 0 ? n : 0;
      };
      const renderCount = () => {
        const el = document.getElementById('kyt-count');
        if (el) {
          const n = load();
          el.textContent = n > 0 ? `この端末からの記録: ${n}件` : '';
        }
      };

      kytForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = (id: string) =>
          (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value?.trim() || '';
        const result = document.getElementById('kyt-result');
        if (!result) return;
        result.classList.remove('hidden');
        const missing = ['kyt-bamen', 'kyt-r1', 'kyt-r2', 'kyt-r3', 'kyt-r4'].filter((id) => !val(id));
        if (missing.length > 0) {
          result.textContent = '差戻し: 4ラウンドすべての記入が必要です。KYTは省略した瞬間に形骸化します。';
          result.className = 'mt-3 border border-[#c00] bg-[#fdeaea] px-3 py-2 text-[12px] font-bold text-[#c00]';
          return;
        }
        const r4 = val('kyt-r4');
        const yoshi = /ヨシ[！!]?$/.test(r4);
        localStorage.setItem(KEY, String(load() + 1));
        renderCount();
        const no = 'KYT-2026-' + String(Math.floor(Math.random() * 90000) + 10000);
        result.textContent =
          `記録番号 ${no} で登録されました。行動目標を朝礼で唱和してください。` +
          (yoshi ? '' : ' ※行動目標が「ヨシ！」で終わっていません。指差し唱和の形を推奨します。');
        result.className = 'mt-3 border border-[#1b3a6b] bg-[#eef7ee] px-3 py-2 text-[12px] font-bold';
      });

      // OPL台帳のクライアント検索
      const q = document.getElementById('opl-q') as HTMLInputElement | null;
      const rows = document.getElementById('opl-rows');
      q?.addEventListener('input', () => {
        if (!rows) return;
        const t = q.value.trim().toLowerCase();
        rows.querySelectorAll('tr').forEach((tr) => {
          (tr as HTMLElement).style.display = !t || (tr.textContent || '').toLowerCase().includes(t) ? '' : 'none';
        });
      });

      renderCount();
    }
  </script>
</Base>
