---
// 4M変化点管理ボード — ダラリ重工業の品質システム(という設定のパロディページ)。
// 人・機械・材料・方法の変化点を登録して品質リスクを先回りする、製造業の背骨。
// 他のAI系サイトが絶対書けないゾーン。登録フォームつき(番号発行のみ・localStorage件数)。
import Base from '@/layouts/Base.astro';

// 変化点台帳: [日付, 4M, ライン, 内容, リスクと処置, 状態]
const board: [string, string, string, string, string, string][] = [
  ['08/17', '人', '第2ライン', '若手・伸彦を検査工程に初配置（星取表△・指導者つき）', '初品・終品は班長がダブルチェック', '監視中'],
  ['08/12', '機械', '第2ライン', '圧入治具の爪を更新（摩耗のため）', '初品50個を全数検査→問題なし', '完了'],
  ['08/08', '材料', '第1ライン', '接点材料のロット切替（サプライヤー同一・ロット違い）', '受入検査強化（n=5→n=20）→問題なし', '完了'],
  ['08/04', '方法', '第2ライン', '段取り替え手順を改訂（作業標準書 第6版→第7版）', '改訂後1週間は所要時間を記録→短縮を確認', '完了'],
  ['07/28', '人', '第1ライン', '応援作業者2名を受け入れ（製造二課より・3日間）', '単独作業は組立のみに限定', '完了'],
];
---

<Base
  title="4M変化点管理ボード（架空企業の社内システム）"
  description="架空企業ダラリ重工業の4M変化点管理ボード（という設定のページ）。人・機械・材料・方法の変更を登録して品質リスクを先回りします。"
>
  <div
    class="min-h-screen bg-[#d4d0c8] text-[13px] text-[#222]"
    style="font-family: 'Hiragino Kaku Gothic ProN', 'MS PGothic', 'Yu Gothic', sans-serif;"
  >
    <div class="bg-shu px-4 py-2 text-center text-xs font-bold text-white">
      ⚠️ これは「<a href="/" class="underline decoration-white/60 underline-offset-2">AIカイゼン</a>」の記事に登場する架空企業の社内システム（という設定）です。実際に入力して遊べます（保存はお使いのブラウザ内のみ）。
    </div>

    <div class="border-b-4 border-[#1b3a6b] bg-gradient-to-b from-[#3a5f9e] to-[#1b3a6b] px-4 py-3 text-white">
      <div class="mx-auto flex max-w-4xl items-baseline justify-between">
        <p class="text-lg font-bold">4M変化点管理ボード｜製造部</p>
        <p class="text-[11px] text-white/80">所管: 製造部・品質保証部（様式Q-11）｜ 朝礼で共有</p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl space-y-4 px-4 py-6">
      <p class="mb-1 text-[11px]">
        <a href="/company/intranet/" class="text-[#00c] underline">DARARIポータル</a> &gt; 品質 &gt; 4M変化点管理
      </p>

      <div class="border border-[#999] bg-[#fffbe6] px-3 py-2 text-[11px] leading-relaxed">
        【原則】品質不良の多くは<b>変化点</b>で起きます。人（Man）・機械（Machine）・材料（Material）・方法（Method）が変わる日は、先回りして手を打ちます。<br />
        【注意】「変化点なし」と書いた日が続く職場は、変化に気づいていないだけです（品質保証部）。<br />
        【運用】変化点は前日までに登録し、朝礼で共有してください。計画外の変化（欠勤・設備故障）は発生時点で登録します。
      </div>

      <!-- ボード -->
      <div class="border border-[#999] bg-white">
        <p class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">■ 変化点ボード（直近）</p>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[680px] border-collapse text-[12px]">
            <thead>
              <tr class="bg-[#f5f5f0] text-left">
                <th class="w-16 border border-[#ddd] px-2 py-1.5">日付</th>
                <th class="w-14 border border-[#ddd] px-2 py-1.5 text-center">4M</th>
                <th class="w-24 border border-[#ddd] px-2 py-1.5">ライン</th>
                <th class="border border-[#ddd] px-2 py-1.5">変化点の内容</th>
                <th class="border border-[#ddd] px-2 py-1.5">リスクと処置</th>
                <th class="w-20 border border-[#ddd] px-2 py-1.5">状態</th>
              </tr>
            </thead>
            <tbody>
              {
                board.map(([date, m, line, naiyo, risk, state]) => (
                  <tr>
                    <td class="border border-[#ddd] px-2 py-1.5">{date}</td>
                    <td class:list={['border border-[#ddd] px-2 py-1.5 text-center font-bold', m === '人' ? 'bg-[#fdeaea]' : m === '機械' ? 'bg-[#e8f0fa]' : m === '材料' ? 'bg-[#eef7ee]' : 'bg-[#fdf6e3]']}>{m}</td>
                    <td class="border border-[#ddd] px-2 py-1.5">{line}</td>
                    <td class="border border-[#ddd] px-2 py-1.5">{naiyo}</td>
                    <td class="border border-[#ddd] px-2 py-1.5 text-[11px]">{risk}</td>
                    <td class:list={['border border-[#ddd] px-2 py-1.5 text-center text-[11px]', state === '監視中' && 'font-bold text-[#a06000]']}>{state}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- 登録 -->
      <div class="border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">変化点 登録</p>
        <form id="henka-form" class="p-4">
          <table class="w-full border-collapse">
            <tbody>
              <tr class="border-b border-[#ddd]">
                <th class="w-40 bg-[#eef1f5] px-3 py-2 text-left font-normal">4M区分<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2">
                  <select id="henka-m" class="border border-[#999] bg-white px-2 py-1">
                    <option>人（Man）</option>
                    <option>機械（Machine）</option>
                    <option>材料（Material）</option>
                    <option>方法（Method）</option>
                  </select>
                  <select id="henka-line" class="ml-2 border border-[#999] bg-white px-2 py-1">
                    <option>第1ライン</option>
                    <option>第2ライン</option>
                    <option>共通</option>
                  </select>
                </td>
              </tr>
              <tr class="border-b border-[#ddd]">
                <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">変化点の内容<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><input id="henka-naiyo" type="text" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="例: 新人を組立工程に配置（指導者つき）" /></td>
              </tr>
              <tr>
                <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">リスクと処置<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><input id="henka-risk" type="text" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="例: 初品・終品を班長がダブルチェック" /></td>
              </tr>
            </tbody>
          </table>
          <div class="mt-4 flex items-center gap-3">
            <button type="submit" class="border border-[#1b3a6b] bg-gradient-to-b from-[#4a6fae] to-[#1b3a6b] px-6 py-1.5 font-bold text-white">登録</button>
            <span class="text-[11px] text-[#666]">登録した変化点は明朝の朝礼で共有されます。</span>
          </div>
          <p id="henka-result" class="mt-3 hidden border px-3 py-2 text-[12px] font-bold"></p>
        </form>
      </div>

      <p class="mt-4 text-[11px] text-[#666]">品質保証部 内線 3300 ｜ 変化点とリスクの書き方に迷ったら<a href="/company/intranet/kyt/" class="text-[#00c] underline">KYT</a>の要領で</p>
    </div>
  </div>

  <script>
    // 掟: 本体が無いページでは何もしない（存在ガード。非null断定は禁止）
    const henkaForm = document.getElementById('henka-form');
    if (henkaForm) {
      (henkaForm as HTMLFormElement).addEventListener('submit', (e) => {
        e.preventDefault();
        const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value?.trim() || '';
        const result = document.getElementById('henka-result');
        if (!result) return;
        result.classList.remove('hidden');
        if (!val('henka-naiyo') || !val('henka-risk')) {
          result.textContent = '差戻し: 内容とリスク・処置の両方を記入してください。「様子を見る」は処置ではありません。';
          result.className = 'mt-3 border border-[#c00] bg-[#fdeaea] px-3 py-2 text-[12px] font-bold text-[#c00]';
          return;
        }
        const no = 'HM-2026-' + String(Math.floor(Math.random() * 90000) + 10000);
        result.textContent = `受付番号 ${no} で登録されました。明朝の朝礼で共有し、初品確認をお願いします。`;
        result.className = 'mt-3 border border-[#1b3a6b] bg-[#eef7ee] px-3 py-2 text-[12px] font-bold';
      });
    }
  </script>
</Base>
