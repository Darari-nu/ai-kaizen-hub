---
// 目標管理シートシステム(様式H-2・β) — ダラリ重工業の社内システム(という設定のパロディページ)。
// darari発案(2026-08-17)「部門計画をもとに一般社員が目標管理シートを書ける。究極のタスク管理ツール」。
// 物語: 部門の方針管理はまだExcel(様式H-1)だが、個人目標だけAI活用推進室がβでシステム化を先行。
// 見せ場=「ベクトル整合チェック」: 上位方針「前年比3%」への言及がないと警告される(方針展開の様式美)。
// 「上司ウケする目標管理シートをAIに書かせた」記事の実機。保存はlocalStorage。
import Base from '@/layouts/Base.astro';

// 方針の縦串(所属を選ぶと自動表示)。ポータルの方針体系と同一データ
const chains: Record<string, string[]> = {
  製造一課: [
    '社方針: 変化をおそれず、創造と革新により、新たな百年の礎を築く',
    '製造本部方針: 変化に対応し、生産性を前年比3%改善する',
    '製造部方針: 生産性を前年比3%改善する（本部方針に同じ）',
    '製造一課方針: 段取り時間を前年比3%短縮する',
    '職場方針（第2ライン）: 5Sを徹底する。挨拶をする。前年比3%。',
  ],
  製造二課: [
    '社方針: 変化をおそれず、創造と革新により、新たな百年の礎を築く',
    '製造本部方針: 変化に対応し、生産性を前年比3%改善する',
    '製造部方針: 生産性を前年比3%改善する（本部方針に同じ）',
    '製造二課方針: 切替ロスを前年比3%削減する',
  ],
  品質保証部: [
    '社方針: 変化をおそれず、創造と革新により、新たな百年の礎を築く',
    '品質本部方針: 品質不良ゼロを前提とし、市場クレームを前年比3%削減する',
  ],
  AI活用推進室: [
    '社方針: 変化をおそれず、創造と革新により、新たな百年の礎を築く',
    '製造本部方針: 変化に対応し、生産性を前年比3%改善する',
    'AI活用推進室方針: AIの正規導入により、現場の定型作業を前年比3%…ではなく半分にする（室長試案）',
  ],
};
---

<Base
  title="目標管理シートシステム（架空企業の社内システム）"
  description="架空企業ダラリ重工業の目標管理シート・様式H-2（という設定のページ）。上位方針とのベクトル整合チェックつき。「前年比3%」に言及しないと警告されます。"
>
  <div
    class="min-h-screen bg-[#d4d0c8] text-[13px] text-[#222]"
    style="font-family: 'Hiragino Kaku Gothic ProN', 'MS PGothic', 'Yu Gothic', sans-serif;"
  >
    <div class="bg-shu px-4 py-2 text-center text-xs font-bold text-white">
      ⚠️ これは「<a href="/" class="underline decoration-white/60 underline-offset-2">AIカイゼン</a>」の記事に登場する架空企業の社内システム（という設定）です。実際に入力して遊べます（保存はお使いのブラウザ内のみ）。
    </div>

    <div class="border-b-4 border-[#1b3a6b] bg-gradient-to-b from-[#3a5f9e] to-[#1b3a6b] px-4 py-3 text-white">
      <div class="mx-auto flex max-w-4xl items-baseline justify-between">
        <p class="text-lg font-bold">目標管理シートシステム（様式H-2）</p>
        <p class="text-[11px] text-white/80">β試験運用 ｜ 開発: AI活用推進室（部門方針のシステム化に先行）</p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl space-y-4 px-4 py-6">
      <p class="mb-1 text-[11px]">
        <a href="/company/intranet/" class="text-[#00c] underline">DARARIポータル</a> &gt; 方針管理 &gt; 目標管理シート（個人）
      </p>

      <div class="border border-[#999] bg-[#fffbe6] px-3 py-2 text-[11px] leading-relaxed">
        【β運用】本システムはAI活用推進室が試験運用中です。部門の方針管理（<a href="/files/様式H-1_四半期フォローシート_2025-2026年度.xlsx" class="text-[#00c] underline">様式H-1・Excel</a>）のシステム化に先行して、個人の様式H-2から電子化しています。<br />
        【原則】個人目標は<b>上位方針とベクトルを合わせて</b>設定してください。整合はシステムが確認します。<br />
        【運用】提出したシートは上長面談（年2回・30分。実際は7分で終わります）で使用します。目標は3件まで。多い目標は未達のもとです。
      </div>

      <!-- 方針の縦串 -->
      <div class="border border-[#999] bg-white">
        <p class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">■ あなたの上位方針（自動表示）</p>
        <div class="px-4 py-3">
          <label class="text-[12px]">
            所属:
            <select id="mk-shozoku" class="ml-1 border border-[#999] bg-white px-2 py-1">
              {Object.keys(chains).map((k) => <option>{k}</option>)}
            </select>
          </label>
          <div id="mk-chain" class="mt-3 space-y-1 text-[12px]"></div>
        </div>
      </div>

      <!-- 目標入力 -->
      <div class="border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">2026年度 個人目標（3件まで）</p>
        <form id="mk-form" class="p-4">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-[12px]">
              <thead>
                <tr class="bg-[#f5f5f0] text-left">
                  <th class="w-8 border border-[#ddd] px-2 py-1.5">#</th>
                  <th class="border border-[#ddd] px-2 py-1.5">目標項目（何を）</th>
                  <th class="w-52 border border-[#ddd] px-2 py-1.5">達成基準（どれだけ・数値で）</th>
                  <th class="w-28 border border-[#ddd] px-2 py-1.5">期限</th>
                </tr>
              </thead>
              <tbody>
                {
                  [1, 2, 3].map((n) => (
                    <tr>
                      <td class="border border-[#ddd] px-2 py-1.5 text-center">{n}</td>
                      <td class="border border-[#ddd] px-1 py-1"><input id={`mk-goal-${n}`} type="text" class="w-full border border-[#bbb] px-1 py-0.5" placeholder={n === 1 ? '例: 段取り替え時間の短縮' : ''} /></td>
                      <td class="border border-[#ddd] px-1 py-1"><input id={`mk-kijun-${n}`} type="text" class="w-full border border-[#bbb] px-1 py-0.5" placeholder={n === 1 ? '例: 平均45分→43.6分（前年比3%短縮）' : ''} /></td>
                      <td class="border border-[#ddd] px-1 py-1">
                        <select id={`mk-kigen-${n}`} class="w-full border border-[#bbb] px-0.5 py-0.5">
                          <option>年度末</option>
                          <option>上期末</option>
                          <option>四半期ごと</option>
                        </select>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-[12px]">
            自己啓発目標（任意・評価対象外）:
            <input id="mk-jiko" type="text" class="ml-1 w-72 border border-[#999] bg-white px-2 py-1" placeholder="例: AI活用の星取表を△から○にする" />
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button type="button" id="mk-check" class="border border-[#1b3a6b] bg-gradient-to-b from-[#fff] to-[#cfd9e8] px-4 py-1.5 font-bold text-[#1b3a6b]">ベクトル整合チェック</button>
            <button type="submit" id="mk-submit" class="border border-[#1b3a6b] bg-gradient-to-b from-[#4a6fae] to-[#1b3a6b] px-6 py-1.5 font-bold text-white">提出</button>
            <span class="text-[11px] text-[#666]">チェック → 提出 の順です。提出後の変更は上長面談で。</span>
          </div>
          <div id="mk-result" class="mt-3 hidden border px-3 py-2 text-[12px] font-bold"></div>
        </form>
      </div>

      <p class="mt-4 text-[11px] text-[#666]">
        経営企画本部 企画課 内線 1200（制度）／ AI活用推進室（システム。内線はありません） ｜ 紙の様式H-2も当面併用できます
      </p>
    </div>
  </div>

  <script>
    // 掟: 本体が無いページでは何もしない（存在ガード。非null断定は禁止）
    const mkForm = document.getElementById('mk-form');
    if (mkForm) initMokuhyo(mkForm as HTMLFormElement);

    function initMokuhyo(mkForm: HTMLFormElement) {
      const KEY = 'darari-mokuhyo';
      const chains: Record<string, string[]> = {
        製造一課: [
          '社方針: 変化をおそれず、創造と革新により、新たな百年の礎を築く',
          '製造本部方針: 変化に対応し、生産性を前年比3%改善する',
          '製造部方針: 生産性を前年比3%改善する（本部方針に同じ）',
          '製造一課方針: 段取り時間を前年比3%短縮する',
          '職場方針（第2ライン）: 5Sを徹底する。挨拶をする。前年比3%。',
        ],
        製造二課: [
          '社方針: 変化をおそれず、創造と革新により、新たな百年の礎を築く',
          '製造本部方針: 変化に対応し、生産性を前年比3%改善する',
          '製造部方針: 生産性を前年比3%改善する（本部方針に同じ）',
          '製造二課方針: 切替ロスを前年比3%削減する',
        ],
        品質保証部: [
          '社方針: 変化をおそれず、創造と革新により、新たな百年の礎を築く',
          '品質本部方針: 品質不良ゼロを前提とし、市場クレームを前年比3%削減する',
        ],
        AI活用推進室: [
          '社方針: 変化をおそれず、創造と革新により、新たな百年の礎を築く',
          '製造本部方針: 変化に対応し、生産性を前年比3%改善する',
          'AI活用推進室方針: AIの正規導入により、現場の定型作業を前年比3%…ではなく半分にする（室長試案）',
        ],
      };

      const shozoku = document.getElementById('mk-shozoku') as HTMLSelectElement | null;
      const chainEl = document.getElementById('mk-chain');
      const renderChain = () => {
        if (!chainEl || !shozoku) return;
        const list = chains[shozoku.value] || [];
        chainEl.innerHTML = list
          .map(
            (l, i) =>
              `<p style="margin-left:${i * 1.2}rem" class="text-[12px]"><span class="border border-[#1b3a6b] bg-[#eef1f5] px-1.5 py-0.5 text-[10px] font-bold text-[#1b3a6b]">${l.split(':')[0]}</span> ${l.split(':').slice(1).join(':')}</p>`
          )
          .join('');
      };
      shozoku?.addEventListener('change', () => {
        renderChain();
        invalidate();
      });

      const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value?.trim() || '';
      type Store = { checked: boolean; submitted?: string };
      const load = (): Store => {
        try {
          const raw = localStorage.getItem(KEY);
          if (raw) return JSON.parse(raw) as Store;
        } catch {
          /* 壊れた保存は無視 */
        }
        return { checked: false };
      };
      const save = (s: Store) => localStorage.setItem(KEY, JSON.stringify(s));
      const invalidate = () => {
        const s = load();
        if (s.checked) {
          s.checked = false;
          save(s);
        }
      };
      mkForm.querySelectorAll('input,select').forEach((el) => el.addEventListener('change', invalidate));

      const show = (lines: string[], kind: 'ok' | 'warn' | 'ng') => {
        const el = document.getElementById('mk-result');
        if (!el) return;
        el.classList.remove('hidden');
        el.innerHTML = lines.map((l) => l.replace(/&/g, '&amp;').replace(/</g, '&lt;')).join('<br />');
        el.className =
          kind === 'ng'
            ? 'mt-3 border border-[#c00] bg-[#fdeaea] px-3 py-2 text-[12px] font-bold text-[#c00]'
            : kind === 'warn'
              ? 'mt-3 border border-[#a06000] bg-[#fdf6e3] px-3 py-2 text-[12px] font-bold text-[#a06000]'
              : 'mt-3 border border-[#1b3a6b] bg-[#eef7ee] px-3 py-2 text-[12px] font-bold';
      };

      document.getElementById('mk-check')?.addEventListener('click', () => {
        const goals = [1, 2, 3].map((n) => ({ g: val(`mk-goal-${n}`), k: val(`mk-kijun-${n}`) }));
        const filled = goals.filter((x) => x.g);
        const errors: string[] = [];
        const warns: string[] = [];
        if (filled.length === 0) errors.push('NG: 目標がありません。最低1件は設定してください。');
        filled.forEach((x, i) => {
          if (!x.k) errors.push(`NG: 目標${i + 1} の達成基準が空欄です。`);
          else if (!/[0-9０-９]/.test(x.k)) errors.push(`NG: 目標${i + 1} の達成基準に数値がありません。「がんばる」は測定できません。`);
        });
        const allText = goals.map((x) => x.g + x.k).join('');
        if (filled.length > 0 && !/前年比|3[%％]|さんパーセント/.test(allText)) {
          warns.push('W-01: 上位方針「前年比3%」への言及がありません。ベクトルを合わせてください（言及した瞬間に通る、という説があります）。');
        }
        if (/AI|ＡＩ|自動化/.test(allText) && !/規程|基準|申請|正規/.test(allText)) {
          warns.push('W-02: AI・自動化を目標にする場合は、正規の手続（AI利用規程・申請）への言及を推奨します。こっそりは事故のもとです。');
        }
        if (errors.length > 0) {
          show(errors.concat(warns), 'ng');
          return;
        }
        const s = load();
        s.checked = true;
        save(s);
        if (warns.length > 0) {
          show(warns.concat(['チェック完了（警告つき・提出は可能です）。']), 'warn');
        } else {
          show(['整合チェック: 適合。ベクトルは合っています。【提出】してください。'], 'ok');
        }
      });

      mkForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const s = load();
        if (!s.checked) {
          show(['提出できません: 先に【ベクトル整合チェック】を実施してください。'], 'ng');
          return;
        }
        const no = 'MK-2026-' + String(Math.floor(Math.random() * 90000) + 10000);
        s.submitted = no;
        save(s);
        show([`受理番号 ${no} で提出されました。上長面談（30分の予定・実績7分）でこのシートを使用します。半期後の自己評価もこの画面から入力できるようになる予定です（β）。`], 'ok');
      });

      renderChain();
    }
  </script>
</Base>
