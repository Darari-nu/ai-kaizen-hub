---
// 開発日程作成システム（大日程計画） — ダラリ重工業の社内システム(という設定のパロディページ)。
// 「クッソわかりにくいが、マニュアルには全部書いてある」がコンセプト(2026-08-17 darari発案)。
// 画面は部門コード・週番号・エラーコードだけで語り、意味は操作マニュアル(nittei-manual)にしか書いていない。
// = 「マニュアルをAIに読ませて、AIに大日程を作らせる」記事の実機。全入力欄に安定IDあり。
// クソ仕様一覧(すべてマニュアルに根拠あり): 基準日は月曜のみ／日付でなく週番号で入力／
// 部門はコード表示のみ／変更しても自動描画されない(手動【描画】)／登録の前に【整合チェック】必須。
import Base from '@/layouts/Base.astro';
---

<Base
  title="開発日程作成システム（架空企業の社内システム）"
  description="架空企業ダラリ重工業の開発日程作成システム（という設定のページ）。大日程計画（ガントチャート）が実際に作れます。操作は難解ですが、操作マニュアル第9版に全部書いてあります。"
>
  <div
    class="min-h-screen bg-[#d4d0c8] text-[13px] text-[#222]"
    style="font-family: 'Hiragino Kaku Gothic ProN', 'MS PGothic', 'Yu Gothic', sans-serif;"
  >
    <div class="bg-shu px-4 py-2 text-center text-xs font-bold text-white">
      ⚠️ これは「<a href="/" class="underline decoration-white/60 underline-offset-2">AIカイゼン</a>」の記事に登場する架空企業の社内システム（という設定）です。実際に入力して遊べます（保存はお使いのブラウザ内のみ）。
    </div>

    <div class="border-b-4 border-[#1b3a6b] bg-gradient-to-b from-[#3a5f9e] to-[#1b3a6b] px-4 py-3 text-white">
      <div class="mx-auto flex max-w-5xl items-baseline justify-between">
        <p class="text-lg font-bold">開発日程作成システム</p>
        <p class="text-[11px] text-white/80">DARARI-NITTEI v2.0（2009年導入） ｜ ログイン中: AI活用推進室 さん</p>
      </div>
    </div>

    <div class="mx-auto max-w-5xl px-4 py-6">
      <p class="mb-1 text-[11px]">
        <a href="/company/intranet/" class="text-[#00c] underline">DARARIポータル</a>
        &gt; 業務システム &gt; 開発日程作成システム
      </p>

      <div class="mb-4 border border-[#999] bg-[#fffbe6] px-3 py-2 text-[11px] leading-relaxed">
        【注意】入力方法・コードの意味は<a href="/company/intranet/nittei-manual/" class="text-[#00c] underline">操作マニュアル（第9版・全113ページ）</a>を参照してください。<b>画面には表示されません。</b><br />
        【注意】日程は日付ではなく<b>週番号（第◯週）</b>で入力します（第5章）。基準日は<b class="text-[#c00]">月曜日</b>を指定してください（第4章4.2）。<br />
        【注意】入力を変更しても日程表には自動で反映されません。必ず【描画】を押してください（第8章）。<br />
        【注意】登録の前に【整合チェック】の実施が必要です。エラーコードの意味は第7章の表によります。
      </div>

      <!-- 案件情報 -->
      <div class="border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">案件情報</p>
        <table class="w-full border-collapse">
          <tbody>
            <tr class="border-b border-[#ddd]">
              <th class="w-44 bg-[#eef1f5] px-3 py-2 text-left font-normal">テーマ番号<span class="ml-1 text-[#c00]">*</span></th>
              <td class="px-3 py-2"><input id="nittei-theme" type="text" placeholder="（形式は付録B）" class="w-52 border border-[#999] bg-white px-2 py-1" /></td>
              <th class="w-32 bg-[#eef1f5] px-3 py-2 text-left font-normal">計画種別<span class="ml-1 text-[#c00]">*</span></th>
              <td class="px-3 py-2">
                <select id="nittei-type" class="border border-[#999] bg-white px-2 py-1">
                  <option value="1">1</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                </select>
              </td>
            </tr>
            <tr>
              <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">製品名<span class="ml-1 text-[#c00]">*</span></th>
              <td class="px-3 py-2"><input id="nittei-name" type="text" placeholder="例: 自動組立ユニット AX-7" class="w-72 border border-[#999] bg-white px-2 py-1" /></td>
              <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">基準日<span class="ml-1 text-[#c00]">*</span></th>
              <td class="px-3 py-2"><input id="nittei-base" type="date" class="border border-[#999] bg-white px-2 py-1" /></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 工程行 -->
      <div class="mt-4 border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">工程入力（最大20行）</p>
        <div class="overflow-x-auto p-2">
          <table class="w-full min-w-[720px] border-collapse text-[12px]">
            <thead>
              <tr class="bg-[#f5f5f0] text-left">
                <th class="w-8 border border-[#ddd] px-2 py-1.5">行</th>
                <th class="border border-[#ddd] px-2 py-1.5">工程名</th>
                <th class="w-20 border border-[#ddd] px-2 py-1.5">部門</th>
                <th class="w-28 border border-[#ddd] px-2 py-1.5">担当者</th>
                <th class="w-20 border border-[#ddd] px-2 py-1.5">開始週</th>
                <th class="w-20 border border-[#ddd] px-2 py-1.5">期間(週)</th>
                <th class="w-24 border border-[#ddd] px-2 py-1.5">ゲート</th>
                <th class="w-12 border border-[#ddd] px-2 py-1.5"></th>
              </tr>
            </thead>
            <tbody id="nittei-rows"></tbody>
          </table>
        </div>
        <div class="flex flex-wrap items-center gap-3 px-3 pb-3">
          <button type="button" id="nittei-addrow" class="border border-[#999] bg-gradient-to-b from-[#fff] to-[#ddd] px-4 py-1">行追加</button>
          <button type="button" id="nittei-check" class="border border-[#1b3a6b] bg-gradient-to-b from-[#fff] to-[#cfd9e8] px-4 py-1 font-bold text-[#1b3a6b]">整合チェック</button>
          <button type="button" id="nittei-draw" class="border border-[#1b3a6b] bg-gradient-to-b from-[#4a6fae] to-[#1b3a6b] px-6 py-1 font-bold text-white">描画</button>
          <button type="button" id="nittei-save" class="border border-[#1b3a6b] bg-gradient-to-b from-[#4a6fae] to-[#1b3a6b] px-6 py-1 font-bold text-white">登録</button>
          <span class="text-[10px] text-[#888]">※ボタンの押下順は 整合チェック → 描画 → 登録 です（第8章）。</span>
        </div>
        <div id="nittei-msg" class="mx-3 mb-3 hidden border px-3 py-2 text-[12px] font-bold"></div>
      </div>

      <!-- 日程表（ガント） -->
      <div class="mt-4 border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">大日程計画表（全26週）</p>
        <div class="overflow-x-auto p-2">
          <div id="nittei-chart" class="text-[10px] text-[#888]">（未描画。【描画】を押してください）</div>
        </div>
        <p class="px-3 pb-2 text-[10px] text-[#888]">
          凡例: ■＝工程　◆＝ゲート（DR）　週番号と日付の対応は操作マニュアル第5章の換算による。印刷はA3横・白黒でお願いします。
        </p>
      </div>

      <p class="mt-4 text-[11px] text-[#666]">
        推奨環境: Internet Explorer 11 ／ 解像度 1280×1024 以上 ｜ 開発本部 開発管理課 内線 4100
      </p>
    </div>
  </div>

  <script>
    // 掟: 本体が無いページでは何もしない（存在ガード。非null断定は禁止）
    const rowsBody = document.getElementById('nittei-rows');
    if (rowsBody) initNittei(rowsBody);

    function initNittei(rowsBody: HTMLElement) {
      const KEY = 'darari-nittei';
      const MAX_ROWS = 20;
      const WEEKS = 26;
      const DEPTS = ['--', 'D1', 'D2', 'D3', 'D4', 'D5', 'Q1', 'E1', 'K1', 'S1', 'Z9'];
      const GATES = ['なし', 'DR0', 'DR1', 'DR2', 'DR3', 'DR4'];

      type Row = { k: string; d: string; t: string; s: number | null; l: number | null; g: string };
      type Store = {
        theme: string;
        name: string;
        type: string;
        base: string;
        rows: Row[];
        checked: boolean;
        regno?: string;
      };

      const load = (): Store => {
        try {
          const raw = localStorage.getItem(KEY);
          if (raw) return JSON.parse(raw) as Store;
        } catch {
          /* 壊れた保存は無視 */
        }
        return { theme: '', name: '', type: '1', base: '', rows: [], checked: false };
      };
      const save = (s: Store) => localStorage.setItem(KEY, JSON.stringify(s));

      // 現在の画面からStoreを組み立てる
      const readScreen = (): Store => {
        const s = load();
        s.theme = (document.getElementById('nittei-theme') as HTMLInputElement | null)?.value?.trim() || '';
        s.name = (document.getElementById('nittei-name') as HTMLInputElement | null)?.value?.trim() || '';
        s.type = (document.getElementById('nittei-type') as HTMLSelectElement | null)?.value || '1';
        s.base = (document.getElementById('nittei-base') as HTMLInputElement | null)?.value || '';
        const rows: Row[] = [];
        rowsBody.querySelectorAll('tr').forEach((tr) => {
          const n = tr.getAttribute('data-row');
          if (!n) return;
          const val = (kind: string) =>
            (document.getElementById(`nittei-${kind}-${n}`) as HTMLInputElement | HTMLSelectElement | null)?.value || '';
          rows.push({
            k: val('kotei').trim(),
            d: val('dept'),
            t: val('tanto').trim(),
            s: val('start') ? Number(val('start')) : null,
            l: val('len') ? Number(val('len')) : null,
            g: val('gate'),
          });
        });
        s.rows = rows;
        return s;
      };

      const showMsg = (lines: string[], ok: boolean) => {
        const el = document.getElementById('nittei-msg');
        if (!el) return;
        el.classList.remove('hidden');
        el.innerHTML = lines.map((l) => l.replace(/&/g, '&amp;').replace(/</g, '&lt;')).join('<br />');
        el.className = ok
          ? 'mx-3 mb-3 border border-[#1b3a6b] bg-[#eef7ee] px-3 py-2 text-[12px] font-bold'
          : 'mx-3 mb-3 border border-[#c00] bg-[#fdeaea] px-3 py-2 text-[12px] font-bold text-[#c00]';
      };

      // 入力が変わったら整合チェックは無効に戻る(第7章7.5)
      const invalidate = () => {
        const s = load();
        if (s.checked) {
          s.checked = false;
          save(s);
        }
      };

      let rowSeq = 0;
      function addRow(data?: Row) {
        if (rowsBody.querySelectorAll('tr[data-row]').length >= MAX_ROWS) {
          showMsg(['E-08: 行数が上限（20行）です。超過分は別紙で作成し、合冊してください（第6章6.9）。'], false);
          return;
        }
        rowSeq++;
        const n = String(rowSeq);
        const tr = document.createElement('tr');
        tr.setAttribute('data-row', n);
        tr.innerHTML =
          `<td class="border border-[#ddd] px-2 py-1 text-center row-num"></td>` +
          `<td class="border border-[#ddd] px-1 py-1"><input id="nittei-kotei-${n}" type="text" class="w-full border border-[#bbb] px-1 py-0.5" /></td>` +
          `<td class="border border-[#ddd] px-1 py-1"><select id="nittei-dept-${n}" class="w-full border border-[#bbb] px-0.5 py-0.5">${DEPTS.map((d) => `<option>${d}</option>`).join('')}</select></td>` +
          `<td class="border border-[#ddd] px-1 py-1"><input id="nittei-tanto-${n}" type="text" class="w-full border border-[#bbb] px-1 py-0.5" /></td>` +
          `<td class="border border-[#ddd] px-1 py-1"><input id="nittei-start-${n}" type="number" min="1" max="26" placeholder="第◯週" class="w-full border border-[#bbb] px-1 py-0.5" /></td>` +
          `<td class="border border-[#ddd] px-1 py-1"><input id="nittei-len-${n}" type="number" min="1" max="26" class="w-full border border-[#bbb] px-1 py-0.5" /></td>` +
          `<td class="border border-[#ddd] px-1 py-1"><select id="nittei-gate-${n}" class="w-full border border-[#bbb] px-0.5 py-0.5">${GATES.map((g) => `<option>${g}</option>`).join('')}</select></td>` +
          `<td class="border border-[#ddd] px-1 py-1 text-center"><button type="button" data-delrow="${n}" class="border border-[#999] bg-[#eee] px-1.5 text-[10px]">削除</button></td>`;
        rowsBody.appendChild(tr);
        if (data) {
          const set = (kind: string, v: string) => {
            const el = document.getElementById(`nittei-${kind}-${n}`) as HTMLInputElement | HTMLSelectElement | null;
            if (el) el.value = v;
          };
          set('kotei', data.k);
          set('dept', data.d);
          set('tanto', data.t);
          set('start', data.s === null ? '' : String(data.s));
          set('len', data.l === null ? '' : String(data.l));
          set('gate', data.g);
        }
        tr.querySelector('[data-delrow]')?.addEventListener('click', () => {
          tr.remove();
          renumber();
          invalidate();
        });
        tr.querySelectorAll('input,select').forEach((el) => el.addEventListener('change', invalidate));
        renumber();
      }

      function renumber() {
        rowsBody.querySelectorAll('tr[data-row]').forEach((tr, i) => {
          const num = tr.querySelector('.row-num');
          if (num) num.textContent = String(i + 1);
        });
      }

      // 整合チェック(第7章)。エラーコードで返す。意味はマニュアルにしか書いていない
      function check(s: Store): string[] {
        const errors: string[] = [];
        if (!/^T-\d{4}-\d{3}$/.test(s.theme)) errors.push('E-05: テーマ番号の形式が不正です（付録B）。');
        if (s.type !== '1') errors.push('E-07: 指定の計画種別は現在ご利用いただけません（第4章4.4）。');
        if (!s.base) {
          errors.push('E-04: 基準日が未指定です（第4章4.2）。');
        } else {
          const d = new Date(s.base + 'T00:00:00');
          if (d.getDay() !== 1) errors.push('E-04: 基準日は月曜日を指定してください（第4章4.2）。');
        }
        if (!s.name) errors.push('E-02: 製品名が未入力です（第4章4.3）。');
        if (s.rows.length === 0) errors.push('E-02: 工程行がありません（第6章）。');
        s.rows.forEach((r, i) => {
          const row = `第${i + 1}行`;
          if (!r.k) errors.push(`E-02: ${row} 工程名が未入力です（第6章6.2）。`);
          if (r.d === '--' || !r.d) errors.push(`E-01: ${row} 部門コードが未入力です（付録A）。`);
          if (r.s === null || r.l === null || r.s < 1 || r.l < 1 || r.s + r.l - 1 > WEEKS) {
            errors.push(`E-03: ${row} 開始週または期間が不正です（1〜26週・第5章）。`);
          }
          if (r.g !== 'なし' && r.l !== null && r.l !== 1) {
            errors.push(`E-06: ${row} ゲート行の期間は1週としてください（第6章6.7）。`);
          }
        });
        // DRの順序: DR番号昇順と開始週順が一致すること
        const gates = s.rows
          .filter((r) => r.g !== 'なし' && r.s !== null)
          .map((r) => ({ no: Number(r.g.replace('DR', '')), s: r.s as number }))
          .sort((a, b) => a.no - b.no);
        for (let i = 1; i < gates.length; i++) {
          if (gates[i].s <= gates[i - 1].s) {
            errors.push(`E-06: DR${gates[i].no} の開始週が DR${gates[i - 1].no} 以前になっています（第7章7.3）。`);
          }
        }
        return errors;
      }

      function draw(s: Store) {
        const chart = document.getElementById('nittei-chart');
        if (!chart) return;
        if (s.rows.length === 0) {
          chart.innerHTML = '<span class="text-[10px] text-[#888]">（工程行がありません）</span>';
          return;
        }
        const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
        let html = '<table class="border-collapse text-[10px]"><thead><tr>';
        html += '<th class="border border-[#ccc] bg-[#eef1f5] px-2 py-0.5 text-left whitespace-nowrap">工程／週</th>';
        for (let w = 1; w <= WEEKS; w++) {
          html += `<th class="border border-[#ccc] bg-[#eef1f5] px-1 py-0.5 w-6 text-center">${w}</th>`;
        }
        html += '</tr></thead><tbody>';
        s.rows.forEach((r) => {
          const label = `${esc(r.k || '（無題）')}<span class="text-[#888]">［${esc(r.d)}${r.t ? '・' + esc(r.t) : ''}］</span>`;
          html += `<tr><td class="border border-[#ccc] bg-[#f5f5f0] px-2 py-0.5 whitespace-nowrap">${label}</td>`;
          for (let w = 1; w <= WEEKS; w++) {
            const inBar = r.s !== null && r.l !== null && w >= r.s && w <= r.s + r.l - 1;
            if (r.g !== 'なし' && r.s === w) {
              html += `<td class="border border-[#ccc] px-1 py-0.5 text-center font-bold text-[#c00]" title="${r.g}">◆</td>`;
            } else if (inBar) {
              html += '<td class="border border-[#ccc] bg-[#1b3a6b] px-1 py-0.5"></td>';
            } else {
              html += '<td class="border border-[#ccc] px-1 py-0.5"></td>';
            }
          }
          html += '</tr>';
        });
        html += '</tbody></table>';
        chart.innerHTML = html;
      }

      // ボタン
      document.getElementById('nittei-addrow')?.addEventListener('click', () => addRow());
      document.getElementById('nittei-check')?.addEventListener('click', () => {
        const s = readScreen();
        const errors = check(s);
        if (errors.length > 0) {
          s.checked = false;
          save(s);
          showMsg(errors, false);
        } else {
          s.checked = true;
          save(s);
          showMsg(['整合チェック: 適合（E-00）。【描画】で日程表を確認のうえ、【登録】してください。'], true);
        }
      });
      document.getElementById('nittei-draw')?.addEventListener('click', () => {
        const s = readScreen();
        save(s);
        draw(s);
      });
      document.getElementById('nittei-save')?.addEventListener('click', () => {
        const s = readScreen();
        const prev = load();
        if (!prev.checked) {
          showMsg(['登録できません: 先に【整合チェック】を実施してください（第8章8.3）。入力を変更した場合も再実施が必要です。'], false);
          return;
        }
        const no = 'NT-2026-' + String(Math.floor(Math.random() * 90000) + 10000);
        s.checked = true;
        s.regno = no;
        save(s);
        showMsg([`登録番号 ${no} で登録されました。次回のDRの5営業日前までに、事務局（開発管理課）へ計画表の写しを送付してください。`], true);
      });

      // 案件情報の変更でも整合チェック無効化
      ['nittei-theme', 'nittei-name', 'nittei-type', 'nittei-base'].forEach((id) => {
        document.getElementById(id)?.addEventListener('change', invalidate);
      });

      // 復元
      const saved = load();
      const setVal = (id: string, v: string) => {
        const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
        if (el) el.value = v;
      };
      setVal('nittei-theme', saved.theme);
      setVal('nittei-name', saved.name);
      setVal('nittei-type', saved.type || '1');
      setVal('nittei-base', saved.base);
      if (saved.rows.length > 0) {
        saved.rows.forEach((r) => addRow(r));
        draw(saved);
      } else {
        addRow();
      }
      if (saved.regno) {
        showMsg([`この計画は登録済みです（登録番号 ${saved.regno}）。変更する場合は再度 整合チェック → 登録 を行ってください。`], true);
      }
    }
  </script>
</Base>
