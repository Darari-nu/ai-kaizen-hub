---
// 改善提案システム — ダラリ重工業の社内システム(という設定のパロディページ)。
// 製造業の改善提案制度(1件採用500円〜)の実物。提出前にECRSの「E(やめられないか)」を聞く=記事041と直結。
// 台帳には目安箱と接続した「カレー大盛り基準の標準化」(審査中)を仕込んである。
// 「AIで改善提案を量産したら、先に『やめられないか』と言われた」記事の実機。保存はlocalStorage(件数)。
import Base from '@/layouts/Base.astro';

// 提案台帳(今月の抜粋): [受付番号, 職場, 件名, 区分, 審査結果]
const ledger: [string, string, string, string, string][] = [
  ['KZ-2026-0841', '製造一課', '食堂カレー大盛り基準の標準化（レードル数による定量化）', '経費・その他', '審査中（食堂と協議中。社長も注目）'],
  ['KZ-2026-0838', '製造二課', '会議室の鍵の保管場所を掲示する', '能率', '採用（500円）'],
  ['KZ-2026-0835', '物流課', '台車の右側通行を通路に表示する', '安全', '採用（1,000円・KYT No.0455と連動）'],
  ['KZ-2026-0831', '品質保証部', 'ワンポイントレッスンの検索性向上（まずタイトル一覧の電子化）', '能率', '採用→AI活用推進室へ移管（実装済み）'],
  ['KZ-2026-0822', '製造一課', '月報の手書き清書を廃止する', '能率', '採用（特級 10,000円）。※「やめる」提案が最高額になった初の事例'],
  ['KZ-2026-0815', '生産技術課', '設備点検表の記入欄を大きくする', '能率', '不採用（用紙サイズ変更は様式改定が必要なため。文書管理規程による）'],
];
---

<Base
  title="改善提案システム（架空企業の社内システム）"
  description="架空企業ダラリ重工業の改善提案システム（という設定のページ）。1件採用500円から。提出前に「その作業、やめられませんか」と聞かれます。"
>
  <div
    class="min-h-screen bg-[#d4d0c8] text-[13px] text-[#222]"
    style="font-family: 'Hiragino Kaku Gothic ProN', 'MS PGothic', 'Yu Gothic', sans-serif;"
  >
    <div class="bg-shu px-4 py-2 text-center text-xs font-bold text-white">
      ⚠️ これは「<a href="/" class="underline decoration-white/60 underline-offset-2">AIカイゼン</a>」の記事に登場する架空企業の社内システム（という設定）です。実際に入力して遊べます（保存はお使いのブラウザ内のみ）。
    </div>

    <div class="border-b-4 border-[#1b3a6b] bg-gradient-to-b from-[#3a5f9e] to-[#1b3a6b] px-4 py-3 text-white">
      <div class="mx-auto flex max-w-4xl items-baseline justify-between">
        <p class="text-lg font-bold">改善提案システム</p>
        <p class="text-[11px] text-white/80">所管: 生産技術課（事務局） ｜ 報奨金: 採用500円〜特級10,000円</p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl space-y-4 px-4 py-6">
      <p class="mb-1 text-[11px]">
        <a href="/company/intranet/" class="text-[#00c] underline">DARARIポータル</a> &gt; 現場 &gt; 改善提案システム
      </p>

      <div class="border border-[#999] bg-[#fffbe6] px-3 py-2 text-[11px] leading-relaxed">
        【目標】一人・年2件（目標です。ノルマではありません。ノルマではありませんが、未提出者は課長面談があります）。<br />
        【原則】提出の前に、まず<b>「その作業、やめられないか」</b>を考えてください（改善の型ECRS。やめる提案は歓迎され、過去に特級も出ています）。<br />
        【報奨金】採用500円／優秀2,000円／特級10,000円。効果金額が大きい場合は別途、決算賞与で考慮…されるという言い伝えがあります。
      </div>

      <!-- 提案フォーム -->
      <div class="border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">改善提案 提出（様式G-3）</p>
        <form id="kz-form" class="p-4">
          <table class="w-full border-collapse">
            <tbody>
              <tr class="border-b border-[#ddd]">
                <th class="w-44 bg-[#eef1f5] px-3 py-2 text-left font-normal">区分<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2">
                  <select id="kz-kubun" class="border border-[#999] bg-white px-2 py-1">
                    <option>安全</option>
                    <option>品質</option>
                    <option>能率</option>
                    <option>経費</option>
                    <option>その他</option>
                  </select>
                  <label class="ml-4 text-[11px]"><input type="checkbox" id="kz-ecrs" class="mr-1" />この作業を「やめられないか」を先に検討した（ECRSのE）</label>
                </td>
              </tr>
              <tr class="border-b border-[#ddd]">
                <th class="bg-[#eef1f5] px-3 py-2 text-left align-top font-normal">現状の問題<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><textarea id="kz-genjo" rows="2" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="例: 会議録の発行に毎回20分かかっている"></textarea></td>
              </tr>
              <tr class="border-b border-[#ddd]">
                <th class="bg-[#eef1f5] px-3 py-2 text-left align-top font-normal">改善案<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><textarea id="kz-an" rows="2" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="例: AIによる自動入力に置き換える（AI利用規程に基づく）"></textarea></td>
              </tr>
              <tr>
                <th class="bg-[#eef1f5] px-3 py-2 text-left font-normal">見込み効果<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2"><input id="kz-kouka" type="text" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="例: 月40件×18分短縮=月12時間の削減" /></td>
              </tr>
            </tbody>
          </table>
          <div class="mt-4 flex items-center gap-3">
            <button type="submit" class="border border-[#1b3a6b] bg-gradient-to-b from-[#4a6fae] to-[#1b3a6b] px-6 py-1.5 font-bold text-white">提出</button>
            <span id="kz-count" class="text-[11px] text-[#666]"></span>
          </div>
          <div id="kz-result" class="mt-3 hidden border px-3 py-2 text-[12px] font-bold"></div>
        </form>
      </div>

      <!-- 台帳 -->
      <div class="border border-[#999] bg-white">
        <p class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">■ 今月の提案（抜粋）</p>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[680px] border-collapse text-[12px]">
            <thead>
              <tr class="bg-[#f5f5f0] text-left">
                <th class="w-28 border border-[#ddd] px-2 py-1.5">受付番号</th>
                <th class="w-24 border border-[#ddd] px-2 py-1.5">職場</th>
                <th class="border border-[#ddd] px-2 py-1.5">件名</th>
                <th class="w-24 border border-[#ddd] px-2 py-1.5">区分</th>
                <th class="w-56 border border-[#ddd] px-2 py-1.5">審査結果</th>
              </tr>
            </thead>
            <tbody>
              {
                ledger.map(([no, shokuba, kenmei, kubun, kekka]) => (
                  <tr>
                    <td class="border border-[#ddd] px-2 py-1.5 whitespace-nowrap">{no}</td>
                    <td class="border border-[#ddd] px-2 py-1.5">{shokuba}</td>
                    <td class="border border-[#ddd] px-2 py-1.5">{kenmei}</td>
                    <td class="border border-[#ddd] px-2 py-1.5">{kubun}</td>
                    <td class:list={['border border-[#ddd] px-2 py-1.5 text-[11px]', kekka.startsWith('採用') && 'text-[#1b3a6b]', kekka.startsWith('審査中') && 'font-bold text-[#a06000]', kekka.startsWith('不採用') && 'text-[#888]']}>{kekka}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="px-3 py-2 text-[10px] text-[#888]">
          ※ KZ-2026-0841（カレー大盛り）は<a href="/company/intranet/meyasubako/" class="text-[#00c] underline">社長への目安箱</a>の回答を受けた提案です。制度が接続した歴史的瞬間として事務局が注目しています。<br />
          ※ 審査は月1回の改善提案委員会で行います。結果への異議は受け付けていませんが、再提案は歓迎します。
        </p>
      </div>

      <p class="mt-4 text-[11px] text-[#666]">生産技術課（事務局） 内線 5400 ｜ 紙の提案用紙（様式G-3）も各職場に備付けています</p>
    </div>
  </div>

  <script>
    // 掟: 本体が無いページでは何もしない（存在ガード。非null断定は禁止）
    const kzForm = document.getElementById('kz-form');
    if (kzForm) initKaizen(kzForm as HTMLFormElement);

    function initKaizen(kzForm: HTMLFormElement) {
      const KEY = 'darari-kaizen-count';
      const load = (): number => {
        const n = Number(localStorage.getItem(KEY));
        return Number.isFinite(n) && n > 0 ? n : 0;
      };
      const renderCount = () => {
        const el = document.getElementById('kz-count');
        if (el) {
          const n = load();
          el.textContent = n > 0 ? `この端末からの提案: ${n}件（年間目標2件${n >= 2 ? '・達成です。お疲れさまでした' : ''}）` : '';
        }
      };

      kzForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = (id: string) =>
          (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value?.trim() || '';
        const result = document.getElementById('kz-result');
        if (!result) return;
        result.classList.remove('hidden');
        const ng = (msg: string) => {
          result.textContent = msg;
          result.className = 'mt-3 border border-[#c00] bg-[#fdeaea] px-3 py-2 text-[12px] font-bold text-[#c00]';
        };
        if (!val('kz-genjo') || !val('kz-an') || !val('kz-kouka')) {
          return ng('差戻し: 現状の問題・改善案・見込み効果はすべて必須です。');
        }
        const ecrs = (document.getElementById('kz-ecrs') as HTMLInputElement | null)?.checked || false;
        if (!ecrs && /自動化|AI|ＡＩ|システム/.test(val('kz-an'))) {
          return ng('差戻し: 自動化・AIの提案の前に、まず「その作業をやめられないか」を検討してください（ECRSのE）。やめられる作業を自動化すると、ムダが高速化します。検討済みならチェックを入れて再提出を。');
        }
        if (!/[0-9０-９]/.test(val('kz-kouka'))) {
          return ng('差戻し: 見込み効果に数値がありません。「作業が楽になる」は審査員に伝わりません。時間か金額で書いてください。');
        }
        localStorage.setItem(KEY, String(load() + 1));
        renderCount();
        const no = 'KZ-2026-' + String(Math.floor(Math.random() * 900) + 842);
        result.textContent = `受付番号 ${no} で受け付けました。審査は月1回の改善提案委員会です。採用の場合、報奨金は給与とは別の茶封筒で支給されます（手渡し・押印必要）。`;
        result.className = 'mt-3 border border-[#1b3a6b] bg-[#eef7ee] px-3 py-2 text-[12px] font-bold';
      });

      renderCount();
    }
  </script>
</Base>
