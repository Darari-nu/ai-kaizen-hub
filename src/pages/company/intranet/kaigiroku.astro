---
// 会議録発行システム — ダラリ重工業の社内システム(という設定のパロディページ)。
// 記事007「高額RPA代替」の自動化デモの実機として使う。実際にフォームが動く。
// 2000年代の社内システム様式美: 表組みフォーム・必須の赤アスタリスク・脅し文句の注意書き。
import Base from '@/layouts/Base.astro';
---

<Base
  title="会議録発行システム（架空企業の社内システム）"
  description="架空企業ダラリ重工業の会議録発行システム（という設定のページ）。記事の自動化デモに登場する実機です。"
>
  <div
    class="min-h-screen bg-[#d4d0c8] text-[13px] text-[#222]"
    style="font-family: 'Hiragino Kaku Gothic ProN', 'MS PGothic', 'Yu Gothic', sans-serif;"
  >
    <div class="bg-shu px-4 py-2 text-center text-xs font-bold text-white">
      ⚠️ これは「<a href="/" class="underline decoration-white/60 underline-offset-2">AIカイゼン</a>」の記事に登場する架空企業の社内システム（という設定）です。実際に入力して遊べます。
    </div>

    <div class="border-b-4 border-[#1b3a6b] bg-gradient-to-b from-[#3a5f9e] to-[#1b3a6b] px-4 py-3 text-white">
      <div class="mx-auto flex max-w-4xl items-baseline justify-between">
        <p class="text-lg font-bold">会議録発行システム</p>
        <p class="text-[11px] text-white/80">DARARI-GIJIROKU v2.3.1 ｜ ログイン中: AI活用推進室 さん</p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-4 py-6">
      <p class="mb-1 text-[11px]">
        <a href="/company/intranet/" class="text-[#00c] underline">DARARIポータル</a>
        &gt; 業務システム &gt; 会議録発行システム
      </p>

      <div class="mb-4 border border-[#999] bg-[#fffbe6] px-3 py-2 text-[11px] leading-relaxed">
        【注意】60分間操作がない場合、入力内容は<b class="text-[#c00]">すべて失われます</b>。こまめに一時保存してください。<br />
        【注意】戻るボタンは使用しないでください。入力内容がすべて失われます。<br />
        【お知らせ】操作方法は<a href="/company/intranet/kaigiroku-manual/" class="text-[#00c] underline">操作マニュアル（第7版・全87ページ）</a>を参照してください。
      </div>

      <div class="border-2 border-[#1b3a6b] bg-white">
        <p class="bg-[#1b3a6b] px-3 py-1.5 font-bold text-white">会議録 新規発行</p>
        <form id="gijiroku-form" class="p-4">
          <table class="w-full border-collapse">
            <tbody>
              {
                [
                  ['category', 'カテゴリ', 'select', ['（選択してください）', '定例会議', '臨時会議', '打合せ', '連絡会', 'その他']],
                  ['dest', '宛先（回覧先）', 'select', ['（選択してください）', '部内のみ', '製造本部 全体', '関係部署（個別指定）', '全社']],
                  ['approver', '承認者', 'text', '例: 製造部長'],
                  ['genre', 'ジャンル', 'select', ['（選択してください）', '生産', '品質', '安全', '改善', '教育', 'その他']],
                  ['workplace', '職場', 'select', ['（選択してください）', '製造一課', '製造二課', '生産技術課', '品質保証部', 'AI活用推進室']],
                  ['title', '会議名', 'text', '例: 第2ライン 段取り改善 定例'],
                  ['heldon', '開催日', 'date', ''],
                ].map(([id, label, type, opt]) => (
                  <tr class="border-b border-[#ddd]">
                    <th class="w-44 bg-[#eef1f5] px-3 py-2 text-left align-top font-normal">
                      {label}<span class="ml-1 text-[#c00]">*</span>
                    </th>
                    <td class="px-3 py-2">
                      {type === 'select' ? (
                        <select id={id} name={id} class="border border-[#999] bg-white px-2 py-1">
                          {(opt as string[]).map((o) => (
                            <option>{o}</option>
                          ))}
                        </select>
                      ) : (
                        <input
                          id={id}
                          name={id}
                          type={type}
                          placeholder={typeof opt === 'string' ? opt : ''}
                          class="w-72 border border-[#999] bg-white px-2 py-1"
                        />
                      )}
                    </td>
                  </tr>
                ))
              }
              <tr>
                <th class="w-44 bg-[#eef1f5] px-3 py-2 text-left align-top font-normal">議事内容<span class="ml-1 text-[#c00]">*</span></th>
                <td class="px-3 py-2">
                  <textarea id="body" name="body" rows="6" class="w-full border border-[#999] bg-white px-2 py-1" placeholder="決定事項・保留事項・宿題（担当/期限）を記載のこと"></textarea>
                </td>
              </tr>
            </tbody>
          </table>
          <div class="mt-4 flex items-center gap-3">
            <button type="submit" id="submit-btn" class="border border-[#1b3a6b] bg-gradient-to-b from-[#4a6fae] to-[#1b3a6b] px-6 py-1.5 font-bold text-white">発行</button>
            <button type="button" class="border border-[#999] bg-gradient-to-b from-[#fff] to-[#ddd] px-6 py-1.5">一時保存</button>
            <span class="text-[11px] text-[#666]">発行後の修正は「会議録修正申請書（様式G-7）」の提出が必要です。</span>
          </div>
          <p id="result" class="mt-3 hidden border border-[#1b3a6b] bg-[#eef7ee] px-3 py-2 font-bold"></p>
        </form>
      </div>

      <p class="mt-4 text-[11px] text-[#666]">
        推奨環境: Internet Explorer 6.0 以上（それ以外のブラウザでの動作は保証しません）｜ 情報システム部 内線 2000
      </p>
    </div>
  </div>

  <script>
    const form = document.getElementById('gijiroku-form') as HTMLFormElement;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = document.getElementById('result')!;
      const no = 'GJR-2026-' + String(Math.floor(Math.random() * 90000) + 10000);
      r.textContent = `発行番号 ${no} で登録されました。印刷のうえ、上長の確認を受けてください。`;
      r.classList.remove('hidden');
    });
  </script>
</Base>
