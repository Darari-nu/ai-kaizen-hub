---
// DARARIポータル — ダラリ重工業の社内イントラネット(という設定のパロディページ)。
// 2000年代の社内ポータル様式美: 灰色背景・青リンク・表組み・過剰な「重要」マーク。
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

type Notice = {
  date: string;
  tag: string;
  dept: string;
  text: string;
  href?: string; // リンク先。無し = 読めない社内文書(点線)
  openBot?: boolean; // true = クリックでAI相談窓口ウィジェットを開く
};

// 記事連動: 公開済み記事(draft:false)を「社外掲載の回覧」として自動でお知らせに流す。
// 新規記事を公開するたび、このポータルの通達が勝手に増える(=増築は記事駆動、の運用)。
const trunc = (s: string, n = 26) => (s.length > n ? s.slice(0, n) + '…' : s);
const published = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const articleNotices: Notice[] = published.map((a) => ({
  date: a.data.pubDate.toISOString().slice(0, 10).replaceAll('-', '.'),
  tag: '回覧',
  dept: '広報・IR室',
  text: `社外掲載: 「${trunc(a.data.title)}」（当社を題材とした記事の公開について）`,
  href: `/articles/${a.slug}/`,
}));

const manualNotices: Notice[] = [
  { date: '2026.08.17', tag: '通達', dept: '開発本部', text: '開発日程作成システムの操作マニュアル改訂について（第9版・全113ページ。週番号の数え方は第5章）', href: '/company/intranet/nittei-manual/' },
  { date: '2026.08.17', tag: '重要', dept: '情報システム部', text: '勤怠管理システムの復旧について（7年ぶり。月次申請は本日よりシステムで受け付けます）', href: '/company/intranet/kintai/' },
  { date: '2026.08.17', tag: '通達', dept: '経理部', text: '経費精算システムの利用開始について（領収書は引き続き紙で提出してください）', href: '/company/intranet/keihi/' },
  { date: '2026.08.17', tag: '通達', dept: '開発本部', text: '製品開発基準の分冊化について（ＤＲ0〜ＤＲ4審査要領を子基準として制定）', href: '/company/seihin-kaihatsu-kijun/' },
  { date: '2026.08.15', tag: '重要', dept: '総務部', text: 'AI相談窓口（総務課）の開設について（24時間対応・回答は社内規程に基づきます）', openBot: true },
  { date: '2026.08.10', tag: '重要', dept: '総務部', text: '既存基準へのAI項目追加について（情報セキュリティ・クラウド・調達・契約・製品開発の各基準を改定）', href: '/company/kitei-taikei/' },
  { date: '2026.08.10', tag: '通達', dept: '総務部', text: 'AI関連規程の体系整備について（規程・基準・ガイドラインの制定）', href: '/company/kitei-taikei/' },
  { date: '2026.08.04', tag: '重要', dept: '総務部', text: 'ノー残業デーの徹底について（再周知）（再々周知）' },
  { date: '2026.08.01', tag: '通達', dept: '情報システム部', text: 'AI利用規程（暫定版）の制定について', href: '/company/ai-kitei/' },
  { date: '2026.07.28', tag: 'お願い', dept: '経理部', text: '経費精算の締切厳守について（今月こそ）' },
  { date: '2026.07.15', tag: '通達', dept: '総務部', text: '夏季休業期間中の入退館について' },
  { date: '2026.07.01', tag: '回覧', dept: '広報・IR室', text: '社内報「だらり」7月号を掲載しました' },
  { date: '2026.06.20', tag: '重要', dept: '品質保証部', text: '検査記録の記入漏れ防止について（月例）' },
];

// 日付降順でマージ(YYYY.MM.DD形式なので文字列比較でよい)
const notices: Notice[] = [...manualNotices, ...articleNotices]
  .sort((a, b) => (a.date === b.date ? 0 : a.date < b.date ? 1 : -1))
  .slice(0, 14);

const kettai = [
  ['10万円未満', '課長', '即日〜3営業日'],
  ['100万円未満', '部長', '1〜2週間'],
  ['1,000万円未満', '本部長', '2週間〜1ヶ月'],
  ['1,000万円以上', '稟議（役員決裁）', '1〜6ヶ月'],
  ['クレジットカード払い', '経理部承認（四半期に一回）', '最長3ヶ月'],
];

// 方針の階層。下に降りるほど「前年比3%」が濃くなっていくJTC様式美。
const policies = [
  ['社方針', '変化をおそれず、創造と革新により、新たな百年の礎を築く'],
  ['製造本部方針', '変化に対応し、生産性を前年比3%改善する'],
  ['製造部方針', '生産性を前年比3%改善する（本部方針に同じ）'],
  ['製造一課方針', '段取り時間を前年比3%短縮する'],
  ['職場方針（第2ライン）', '5Sを徹底する。挨拶をする。前年比3%。'],
];

// 規程集はグループ表示（2026-08-10 darari指示「もうちょい見やすくw」）。
// [グループ名, NEWバッジ, [[名前, href], ...]] hrefが空 = 準備中（点線）
const ruleGroups: [string, boolean, [string, string][]][] = [
  ['よく使う', false, [
    ['📚 社内規程管理台帳（全32規程の一覧はこちら）', '/company/kitei-ichiran/'],
    ['決裁権限表（抜粋）', '#kettai'],
  ]],
  ['規程（全文閲覧可）', false, [
    ['稟議規程', '/company/ringi-kitei/'],
    ['文書管理規程', '/company/bunsho-kitei/'],
    ['情報セキュリティ管理規程', '/company/joho-security-kitei/'],
    ['出張旅費規程', '/company/shucchou-kitei/'],
    ['慶弔見舞金規程', '/company/keichou-kitei/'],
  ]],
  ['AI関連の体系', true, [
    ['社内規程体系（AI関連）─まずこれ', '/company/kitei-taikei/'],
    ['AI利用規程', '/company/ai-kitei/'],
    ['生成AI活用ガイドライン（現場のコツ集）', '/company/ai-guideline/'],
  ]],
  ['基準（AIは既存基準の中にあります）', true, [
    ['情報セキュリティ基準', '/company/joho-security-kijun/'],
    ['個人情報取扱基準', '/company/kojin-joho-kijun/'],
    ['クラウドサービス利用基準', '/company/cloud-kijun/'],
    ['調達基準（サプライヤー評価）', '/company/chotatsu-kijun/'],
    ['契約審査基準（秘密保持条項）', '/company/keiyaku-kijun/'],
    ['製品開発基準（ステージゲート）', '/company/seihin-kaihatsu-kijun/'],
    ['└ ＤＲ審査要領（DR0〜DR4・開基-001の子基準）', '/company/seihin-kaihatsu-kijun-dr0/'],
  ]],
  ['整備待ち', false, [
    ['社印取扱規程', ''],
  ]],
];

// 社員限定の回覧資料(入社=Substack登録の演出)。存在を約束しすぎない=「順次回覧」表記
const kairan = [
  ['稟議実録「AI導入編」（差し戻し2回の記録つき）', ''],
  ['規程ひな形・編集可能版（自社用に流用可）', ''],
  ['決裁権限表（全文・運用注記つき）', ''],
];
---

<Base
  title="DARARIポータル（架空企業の社内サイト）"
  description="架空企業ダラリ重工業の社内ポータル（という設定のページ）。通達・規程・AI相談窓口・決裁権限表・方針の階層が閲覧できます。"
>
  <div
    class="min-h-screen bg-[#d4d0c8] text-[13px] text-[#222]"
    style="font-family: 'Hiragino Kaku Gothic ProN', 'MS PGothic', 'Yu Gothic', sans-serif;"
  >
    <!-- 架空明示バナー -->
    <div class="bg-shu px-4 py-2 text-center text-xs font-bold text-white">
      ⚠️ これは「<a href="/" class="underline decoration-white/60 underline-offset-2">AIカイゼン</a>」の記事に登場する架空企業の社内サイト（という設定）です。
    </div>

    <!-- ポータルヘッダー -->
    <div class="border-b-4 border-[#1b3a6b] bg-gradient-to-b from-[#3a5f9e] to-[#1b3a6b] px-4 py-3 text-white">
      <div class="mx-auto flex max-w-4xl items-baseline justify-between">
        <p class="text-lg font-bold">DARARIポータル</p>
        <p class="text-[11px] text-white/80">社内限 ｜ ようこそ、AI活用推進室 さん（前回ログイン: 昨日 22:47）</p>
      </div>
    </div>

    <!-- ポータル内検索(動かないのが様式美) -->
    <div class="border-b border-[#999] bg-[#e8e5de] px-4 py-1.5">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-2">
        <input
          disabled
          placeholder="ポータル内検索"
          class="w-40 border border-[#999] bg-[#f5f5f0] px-2 py-0.5 text-[11px]"
        />
        <button disabled class="border border-[#999] bg-[#ddd] px-2 py-0.5 text-[11px] text-[#888]">検索</button>
        <span class="text-[10px] text-[#888]">※検索機能は2019年のリニューアル以降、復旧の目処が立っていません。お探しの規程はAI相談窓口へ。</span>
      </div>
    </div>

    <div class="mx-auto max-w-4xl space-y-4 px-3 py-4">
      <!-- お知らせ -->
      <div class="border border-[#999] bg-white">
        <div class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">
          ■ お知らせ・通達
        </div>
        <ul class="divide-y divide-[#eee] px-3 py-1">
          {
            notices.map((n) => (
              <li class="flex flex-wrap items-baseline gap-2 py-1.5">
                <span class="text-[#888]">{n.date}</span>
                <span
                  class:list={[
                    'px-1.5 py-0.5 text-[10px] font-bold',
                    n.tag === '重要' ? 'bg-[#c00] text-white' : 'bg-[#eef1f5] text-[#1b3a6b] border border-[#1b3a6b]',
                  ]}
                >
                  {n.tag}
                </span>
                <span class="text-[#666]">[{n.dept}]</span>
                {n.openBot ? (
                  <button type="button" data-open-bot class="text-left text-[#00c] underline">
                    {n.text}
                  </button>
                ) : n.href ? (
                  <a href={n.href} class="text-[#00c] underline">
                    {n.text}
                  </a>
                ) : (
                  <span class="cursor-default text-[#00c] underline decoration-dotted">{n.text}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <!-- 規程集（グループ表示） -->
        <div class="border border-[#999] bg-white">
          <div class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">
            ■ 社内規程集
          </div>
          {
            ruleGroups.map(([group, isNew, items]) => (
              <div>
                <div class="flex items-center gap-2 border-b border-[#eee] bg-[#f5f5f0] px-3 py-1 text-[11px] font-bold text-[#666]">
                  {group}
                  {isNew && <span class="bg-[#c00] px-1.5 py-0.5 text-[9px] font-bold text-white">NEW</span>}
                </div>
                <ul class="divide-y divide-[#f3f3ee] px-3 py-0.5">
                  {items.map(([name, href]) => (
                    <li class="flex items-baseline justify-between py-1">
                      {href ? (
                        <a href={href} class="text-[#00c] underline">
                          {name}
                        </a>
                      ) : (
                        <span class="cursor-default text-[#00c] underline decoration-dotted">{name}</span>
                      )}
                      {!href && <span class="text-[10px] text-[#999]">PDF 準備中</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="space-y-4">
          <!-- リンク集 -->
          <div class="border border-[#999] bg-white">
            <div class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">
              ■ 社内システム
            </div>
            <ul class="divide-y divide-[#eee] px-3 py-1 text-[#00c]">
              <li class="py-1.5">
                <button type="button" data-open-bot class="underline">AI相談窓口（総務課・忍者）</button>
                <span class="ml-2 text-[10px] font-bold text-[#1b3a6b]">←これは使えます（24時間対応）</span>
              </li>
              <li class="py-1.5"><a href="/company/intranet/kadou-shukei/" class="underline">設備稼働集計（月次）</a><span class="ml-2 text-[10px] font-bold text-[#1b3a6b]">8月度よりAI自動集計</span></li>
              <li class="py-1.5"><a href="/company/intranet/kaigiroku/" class="underline">会議録（AI自動作成）</a><span class="ml-2 text-[10px] text-[#1b3a6b]"><a href="/company/intranet/kaigiroku-manual/" class="underline">操作手引</a></span></li>
              <li class="py-1.5"><a href="/company/intranet/nittei/" class="underline">開発日程作成システム（大日程）</a><span class="ml-2 text-[10px] text-[#1b3a6b]"><a href="/company/intranet/nittei-manual/" class="underline">操作手引（第9版・必読）</a></span></li>
              <li class="py-1.5"><a href="/company/intranet/kintai/" class="underline">勤怠管理システム</a><span class="ml-2 text-[10px] font-bold text-[#c00]">8/17 復旧しました（7年ぶり）</span></li>
              <li class="py-1.5"><a href="/company/intranet/keihi/" class="underline">経費精算システム</a><span class="ml-2 text-[10px] text-[#c00]">Internet Explorer 11 推奨</span></li>
              <li class="py-1.5"><a href="/company/intranet/bunsho/" class="underline">文書管理システム</a><span class="ml-2 text-[10px] text-[#999]">（要VPN→接続済みと判定されます）</span></li>
              <li class="py-1.5"><span class="cursor-default underline decoration-dotted">Copilot Chat</span><span class="ml-2 text-[10px] text-[#999]">（ライセンス申請中・稟議148日目）</span></li>
            </ul>
          </div>

          <!-- 庶務連絡(様式美の小ネタ枠) -->
          <div class="border border-[#999] bg-white">
            <div class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">
              ■ 庶務連絡
            </div>
            <ul class="space-y-1.5 px-3 py-2 text-[12px]">
              <li><span class="font-bold text-[#666]">【安全】</span>今月の安全標語: 「まだいける」 その油断が 命取り（製造二課・入選作）</li>
              <li><span class="font-bold text-[#666]">【食堂】</span>本日のA定食: 生姜焼き ／ B定食: 焼き魚（売切）※カレーの大盛りは廃止になりました</li>
              <li><span class="font-bold text-[#666]">【会議室】</span>本日の空きはありません（第3会議室は資材置場のため当面予約不可）</li>
              <li><span class="font-bold text-[#666]">【落とし物】</span>認印1本を総務部で保管しています（8月末で処分します）</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 決裁権限表 -->
      <div class="border border-[#999] bg-white" id="kettai">
        <div class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">
          ■ 決裁権限表（抜粋）
        </div>
        <table class="w-full border-collapse text-[12px]">
          <thead>
            <tr class="bg-[#f5f5f0] text-left">
              <th class="border border-[#ddd] px-3 py-1.5">金額</th>
              <th class="border border-[#ddd] px-3 py-1.5">決裁者</th>
              <th class="border border-[#ddd] px-3 py-1.5">所要期間（目安）</th>
            </tr>
          </thead>
          <tbody>
            {
              kettai.map(([amount, approver, period]) => (
                <tr>
                  <td class="border border-[#ddd] px-3 py-1.5">{amount}</td>
                  <td class="border border-[#ddd] px-3 py-1.5">{approver}</td>
                  <td class="border border-[#ddd] px-3 py-1.5">{period}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="px-3 py-2 text-[11px] text-[#888]">
          ※ 有料クラウドサービス（SaaS等）の新規契約は、金額にかかわらず情報システム部・法務部の事前確認が必要です。
        </p>
      </div>

      <!-- 方針の階層 -->
      <div class="border border-[#999] bg-white">
        <div class="border-b border-[#999] bg-[#eef1f5] px-3 py-1.5 font-bold text-[#1b3a6b]">
          ■ 2026年度 方針体系（方針管理）
        </div>
        <div class="space-y-0 px-3 py-3">
          {
            policies.map(([level, text], i) => (
              <div>
                {i > 0 && <div class="ml-6 h-3 w-px bg-[#999]" />}
                <div class="flex items-baseline gap-3" style={`margin-left: ${i * 1.5}rem`}>
                  <span class="shrink-0 border border-[#1b3a6b] bg-[#eef1f5] px-2 py-0.5 text-[10px] font-bold text-[#1b3a6b]">
                    {level}
                  </span>
                  <span class="text-[12px]">{text}</span>
                </div>
              </div>
            ))
          }
          <p class="mt-3 text-[11px] text-[#888]">
            ※ 下位方針は上位方針とベクトルを合わせて策定してください（毎年1月・方針展開会議にて審議）。
          </p>
        </div>
      </div>

      <!-- 回覧板(社員限定・登録導線) -->
      <div class="border-2 border-[#c00] bg-[#fffbe6] px-4 py-3 text-[12px]" id="kairan">
        <p class="font-bold text-[#c00]">🔒 回覧板（社員限定資料）</p>
        <ul class="mt-2 divide-y divide-[#eee0b0]">
          {
            kairan.map(([name]) => (
              <li class="flex flex-wrap items-baseline justify-between gap-2 py-1.5">
                <span class="cursor-default text-[#00c] underline decoration-dotted">🔒 {name}</span>
                <span class="text-[10px] text-[#999]">要社員証・順次回覧</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-2 leading-relaxed">
          回覧資料の閲覧には社員証が必要です。お持ちでない方は、入社手続き（<a href="https://dararinu.substack.com" class="font-bold text-[#00c] underline">Substack無料登録・1分</a>）をお願いします。
          新しい通達も受信箱に届き、回覧資料は整い次第そちらでお回しします。
        </p>
      </div>

      <!-- フッター -->
      <div class="pb-6 text-center text-[11px] text-[#666]">
        <p>本ポータルは社内専用です。画面の印刷・持ち出しは所属長の承認を得てください。</p>
        <p class="mt-1">推奨環境: Internet Explorer 11 ／ 解像度 1024×768 以上</p>
        <p class="mt-3">
          <a href="/company/" class="text-[#00c] underline">コーポレートサイトへ</a> ｜
          <a href="/" class="text-[#00c] underline">AIカイゼン（実況サイト）へ</a>
        </p>
      </div>
    </div>
  </div>
</Base>

<script>
  // AI相談窓口への導線: data-open-bot要素のクリックでChatWidgetのパネルを開く。
  // 掟: 要素が無いページ・状況では何もしない(存在ガード必須。非null断定は禁止)
  const openBtn = document.getElementById('djb-open');
  const panel = document.getElementById('djb-panel');
  document.querySelectorAll('[data-open-bot]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (panel && panel.hidden) openBtn?.click();
    });
  });
</script>
