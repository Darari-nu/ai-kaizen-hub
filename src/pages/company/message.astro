// 社長メッセージ集 — 陀楽進の「ありがたい話」ストック(という設定のページ)。
// 人格の正本=10_drafts/45_社長脳/IDENTITY_陀楽進.md(ツェッテルカステンから型を引いて書く)。
// 将来「AI社長にしてみた」記事のビフォー素材。1本増やすたびにストックが資産になる。
import Base from '@/layouts/Base.astro';

// [日付, 場面, タイトル, 本文段落[]]
const messages: [string, string, string, string[]][] = [
  [
    '2026年1月5日',
    '年頭挨拶（仕事始め式）',
    '丙午の年、着実に前へ',
    [
      '新年あけましておめでとうございます。旧年中の社員各位の精励に、心より感謝を申し上げます。',
      '本年は丙午（ひのえうま）。炎のような勢いで駆け上がる馬の年と聞いております。世間ではAI（人工知能）なるものの進展が目覚ましく、人手の不足も相まって、当社を取り巻く環境はまさに変化の只中にあります。しかし、変化の風は、受け止め方ひとつで前進の追い風となります。恐れる必要はありません。',
      'そのうえで本年の方針は三つ。人づくり、現場、そしてデジタル何とかであります。いずれも拙速は禁物です。馬の勢いに任せず、一歩一歩、着実に歩みを進めてまいりましょう。',
      '結びに、社員の皆さんとご家族の健康を祈念し、年頭の挨拶といたします。本年もどうぞよろしくお願いいたします。',
    ],
  ],
  [
    '2026年4月1日',
    '中期経営計画「DARARI 2030」策定にあたって',
    '数字がすべてではない。しかし数字はすべてに付く',
    [
      'このたび、2030年度を最終年度とする中期経営計画「DARARI 2030」を策定いたしました。',
      '私は常々、数字がすべてではないと申し上げてまいりました。会社の礎は人であり、現場であり、誠実・堅実・着実の社是であります。',
      'そのうえで、本計画には売上高前年比3%成長、生産性前年比3%改善、不良率の削減目標を掲げております。数字は目的ではなく、皆さんの努力が実ったことを確認するための道しるべであります。各部門におかれては、方針管理の仕組みに沿って、それぞれの持ち場の数字に翻訳していただきたい。',
      '2030年、当社は創立72年を迎えます。新たな百年の礎を、皆さんとともに築いてまいる所存です。',
    ],
  ],
  [
    '2025年10月14日',
    '創立67周年記念式典 訓話',
    'リレー1個の手組みから',
    [
      '本日、当社は創立67周年を迎えました。お取引先の皆さま、地域の皆さま、そして社員各位の日頃のご尽力に、深く感謝を申し上げます。',
      '毎年この日にお話ししておりますので、皆さんもうご存知と思いますが、当社の始まりは昭和33年、灰谷県時差市の小さな作業場で、創業者が産業用リレーを1個ずつ手で組んだことにあります。冬は指がかじかんで、朝一番の1個がどうしても不良になる。それでも創業者は「不良を出した日ほど、現物をよく見よ」と申しました。温故知新。この教えは今も、当社の品質の背骨であります。',
      '今日の会社があるのは、ひとえに社員の皆さんの努力の賜物です。次の百年に向け、より一層のご尽力をお願い申し上げます。',
    ],
  ],
  [
    '2025年7月7日',
    '2025年度 安全衛生大会 訓示',
    '慣れた頃が、いちばん危ない',
    [
      '本日はご参集いただき、ありがとうございます。ご安全に。',
      '安全は、すべてに優先します。納期にも、原価にも、そして稟議にも優先します。私は稟議を省略するなと常々申しておりますが、安全のための応急措置だけは、やってから報告で構いません。当社で「先にやれ」と言われるのは安全だけです。それだけ重いということです。',
